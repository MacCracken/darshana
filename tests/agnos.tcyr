# darshana AGNOS-arm test suite — v1.0.2.
#
# The `#ifdef CYRIUS_TARGET_AGNOS` arm of src/termios.cyr shipped from
# v0.8.0 with ZERO coverage of any kind. Six public functions
# (tty_winsize, tty_isatty, tty_raw, tty_cooked, tty_open_signalfd,
# tty_close_signalfd), two ADR-0003-FROZEN constants and four internal
# syscall numbers were checked by nothing: no test file touched them, and
# no CI job cross-built them. Both frozen AGNOS constants could be
# corrupted to their Linux values and `cyrius build`, `cyrius lint`, both
# test suites, `scripts/smoke.sh`, `scripts/syscall-audit.sh` and even
# `cyrius build --agnos` all stayed green.
#
# That mattered because the AGNOS values DIFFER from the Linux ones by
# design and cannot be inferred: mirshi represents a signal set as
# `1 << sig`, where Linux sigset_t uses `1 << (sig - 1)`. Copying the
# Linux values here would silently watch the wrong signals — which is
# exactly what src/termios.cyr's own comment warns about, and what ADR
# 0003 pins ("TTY_SIGMASK_EXIT is 0x4003 on Linux and 0x8006 on AGNOS,
# and stays so").
#
# Build it for the AGNOS target and run the result:
#
#     cyrius build --agnos tests/agnos.tcyr build/agnos-tests
#     ./build/agnos-tests
#
# That works on an ordinary x86_64 Linux host (and in CI): `--agnos`
# emits an x86_64 ELF, and write(2)=1 / exit(2) are reachable either way,
# so the stdlib assert harness runs unmodified.
#
# ⛔ WHAT MUST NOT BE CALLED HERE, AND WHY.
# Only calls that issue no syscall are safe to EXECUTE on a Linux host. The
# AGNOS peers issue winsize#60 (the stdlib's `sys_winsize`), the agnos
# signalfd pair, or (v1.5.0) console_mode#110 and fd_kind#111 — and on
# x86_64 Linux syscall 60 is `exit`, 110 `getppid` and 111 `getpgrp`.
# Calling `tty_isatty` or `tty_winsize` from this harness would terminate
# the process with status 0 mid-run: a green result that proved nothing,
# which is worse than no test. A console-mode call would "succeed" with a
# pid. So this file calls a peer only on a path that stops before any
# syscall: an out-of-range fd, the cached "this kernel lacks the calls"
# answer, or a slot path that makes no call. The rest runs on a real agnos
# kernel, in tests/agnos_live.cyr (scripts/agnos-live.sh). Do not "improve"
# this file by calling them.

include "src/main.cyr"

fn main() {
    alloc_init();

    # ---- frozen constant values (ADR 0003) -------------------------
    # These are the two constants whose AGNOS values differ from Linux.
    # mirshi's set layout is `1 << sig`, not Linux's `1 << (sig - 1)`.
    test_group("AGNOS arm — frozen constant values (ADR 0003)");
    assert_eq(TTY_SIGMASK_EXIT, 0x8006,
        "AGNOS EXIT mask = 1<<1 | 1<<2 | 1<<15 (HUP|INT|TERM), not Linux 0x4003");
    assert_eq(TTY_SIGMASK_WINCH, 0x10000000,
        "AGNOS WINCH mask = 1<<28 (SIGWINCH), not Linux 0x08000000");
    assert_eq(TTY_SIGMASK_EXIT & TTY_SIGMASK_WINCH, 0,
        "AGNOS EXIT and WINCH masks are disjoint");
    # Spell the bit positions out independently of the hex literals, so a
    # typo'd constant cannot agree with a typo'd expectation.
    assert_eq(TTY_SIGMASK_EXIT, (1 << 1) | (1 << 2) | (1 << 15),
        "EXIT mask is exactly SIGHUP(1), SIGINT(2), SIGTERM(15) under 1<<sig");
    assert_eq(TTY_SIGMASK_WINCH, 1 << 28,
        "WINCH mask is exactly SIGWINCH(28) under 1<<sig");
    # v1.3.0 — inert on agnos (no SIGPIPE), but laid out like the others.
    assert_eq(TTY_SIGMASK_PIPE, 1 << 13, "PIPE mask is SIGPIPE(13) under 1<<sig = 0x2000");
    assert_eq(TTY_SIGMASK_PIPE & (TTY_SIGMASK_EXIT | TTY_SIGMASK_WINCH), 0, "PIPE is disjoint from EXIT and WINCH");

    # ---- the agnos syscall numbers this arm relies on --------------
    # The arm calls the stdlib's agnos wrappers, which own the numbers.
    # These pin the numbers to the agnos ABI the arm was verified against,
    # so a stdlib that renumbered one fails here instead of silently
    # issuing a different syscall — the v0.9.2 SYS_IOCTL class of bug,
    # with no diagnostic on this target either.
    test_group("AGNOS arm — agnos syscall numbers (stdlib)");
    assert_eq(SYS_WINSIZE, 60, "framebuffer console grid is winsize#60");
    assert_eq(SYS_SIGPROCMASK, 17, "sigprocmask is #17");
    assert_eq(SYS_SIGNALFD, 18, "signalfd is #18");
    assert_eq(SFD_CLOEXEC, 0x80000, "SFD_CLOEXEC is 0x80000, as on Linux");
    assert_eq(SIG_BLOCK, 0, "sigprocmask how: SIG_BLOCK is 0");
    assert_eq(SIG_UNBLOCK, 1, "sigprocmask how: SIG_UNBLOCK is 1");
    # v1.5.0 — the console-mode and fd-kind calls (agnos 1.57.13) and the
    # values the arm reads back from them.
    assert_eq(SYS_CONSOLE_MODE, 110, "console_mode is #110");
    assert_eq(SYS_FD_KIND, 111, "fd_kind is #111");
    assert_eq(CM_NOECHO, 1, "CM_NOECHO is bit 0");
    assert_eq(CM_FLUSH, 2, "CM_FLUSH is bit 1");
    assert_eq(FDK_CONSOLE, 1, "fd_kind: the console is 1");
    assert_eq(FDK_CHAN, 5, "fd_kind: a #97 channel endpoint is 5");

    # ---- the no-termios contract -----------------------------------
    # agnos has no TCGETS/TCSETS, so there is no raw/cooked toggle. The
    # honest verdict is -1 from tty_raw, so consumers take their designed
    # fallback (chakshu/thoth drop to a line REPL); tty_cooked is an
    # idempotent no-op success, matching the Linux "no-op when not raw".
    # Neither issues a syscall, so both are safe to execute here.
    # v1.2.0 — the AGNOS winsize decode, pure and so testable here. A real
    # 80x24 console packs as (80 << 16) | 24. Bits above 31 are ignored.
    test_group("AGNOS arm — winsize#60 decode");
    var ws_r = 0;
    var ws_c = 0;
    assert_eq(_agnos_winsize_unpack((80 << 16) | 24, &ws_r, &ws_c), 0, "unpack returns 0");
    assert_eq(ws_r, 24, "rows are bits 0-15");
    assert_eq(ws_c, 80, "cols are bits 16-31 (not swapped)");
    _agnos_winsize_unpack((7 << 32) | (0xFFFF << 16) | 0xFFFF, &ws_r, &ws_c);
    assert_eq(ws_r, 0xFFFF, "rows: full u16, high bits ignored");
    assert_eq(ws_c, 0xFFFF, "cols: full u16, bits above 31 ignored");

    test_group("AGNOS arm — no-termios contract");
    assert_eq(tty_raw(0), 0 - 1, "tty_raw always -1 on AGNOS (no termios)");
    assert_eq(tty_raw(1), 0 - 1, "tty_raw is fd-independent on AGNOS");
    assert_eq(tty_cooked(), 0, "tty_cooked is an idempotent no-op success");
    assert_eq(tty_cooked(), 0, "tty_cooked stays 0 when called again");
    assert_eq(tty_forget(), 0, "tty_forget with nothing held is 0");

    # v1.5.0 — an fd outside [0, 0x7FFFFFFF] is refused before anything
    # else, the probe included: `_agnos_tty_calls` staying 0 shows that no
    # console_mode#110 was issued.
    test_group("AGNOS arm — an out-of-range fd is refused before any call");
    _agnos_tty_calls = 0;
    assert_eq(tty_echo_off(0 - 1), 0 - 1, "tty_echo_off(-1) is -1");
    assert_eq(tty_flush_input(1 << 32), 0 - 1, "tty_flush_input(2^32) is -1");
    assert_eq(tty_isatty(0 - 1), 0, "tty_isatty(-1) is 0");
    assert_eq(tty_isatty(1 << 32), 0, "tty_isatty(2^32) is 0");
    assert_eq(_agnos_tty_calls, 0, "and none of them asked the kernel");

    # v1.5.0 — a kernel older than agnos 1.57.13 has neither call. With the
    # cached answer set to "no", the arms give their 1.4.0 answers and issue
    # no syscall.
    test_group("AGNOS arm — before agnos 1.57.13: the 1.4.0 answers");
    _agnos_tty_calls = 0 - 1;
    assert_eq(tty_echo_off(0), 0 - 1, "tty_echo_off is -1: nothing can turn the echo off");
    assert_eq(tty_flush_input(0), 0 - 1, "tty_flush_input is -1: nothing can flush");
    assert_eq(_tty_in_raw, 0, "a refused echo-off holds no slot");
    assert_eq(_agnos_has_tty_calls(), 0, "the cached answer is used, not asked again");
    # v1.6.0 — the public probe says so (ADR 0008).
    assert_eq(tty_isatty_is_per_fd(), 0, "tty_isatty_is_per_fd is 0: tty_isatty answers about the console");
    assert_eq(_agnos_tty_calls, 0 - 1, "and it asked nothing: the cache still says no");

    # v1.6.0 — a kernel that has the calls. The cached "yes" is set by
    # hand, so nothing is asked of the host.
    test_group("AGNOS arm — tty_isatty_is_per_fd on agnos >= 1.57.13");
    _agnos_tty_calls = 1;
    assert_eq(tty_isatty_is_per_fd(), 1, "tty_isatty_is_per_fd is 1: tty_isatty answers about the fd");
    _agnos_tty_calls = 0 - 1;

    # v1.5.0 — the slot paths that make no call.
    test_group("AGNOS arm — the slot");
    _tty_in_raw = 1;
    _tty_raw_fd = 0;
    _agnos_saved_mode = CM_NOECHO;
    assert_eq(tty_cooked(), 0, "echo was already off before: tty_cooked leaves it, with no call");
    assert_eq(_tty_in_raw, 0, "and frees the slot");
    _tty_in_raw = 1;
    assert_eq(tty_forget(), 0, "tty_forget frees a held slot");
    assert_eq(_tty_in_raw, 0, "the slot is free");
    _agnos_saved_mode = 0;

    # ---- Linux constants must NOT leak into this arm ---------------
    # A copy-paste of the Linux block would define TCGETS/TCSETS here.
    # There is no direct way to assert absence, but the AGNOS masks
    # differing from the Linux ones is the observable proxy, and the
    # positional platform gate (scripts/platform-gate.sh) enforces the
    # structural half.
    test_group("AGNOS arm — Linux values did not leak");
    assert_eq(TTY_SIGMASK_EXIT == 0x4003, 0, "EXIT is not the Linux value");
    assert_eq(TTY_SIGMASK_WINCH == 0x08000000, 0, "WINCH is not the Linux value");

    return assert_summary();
}

# ⛔ THE EXIT NUMBER HERE IS THE HOST'S, NOT THE TARGET'S — read this
# before "fixing" it to SYS_EXIT.
#
# This file is CROSS-BUILT for AGNOS (`cyrius build --agnos`) but EXECUTED
# on the x86_64 Linux CI host. The emitted binary is an x86_64 ELF, so
# every syscall it issues is interpreted by the LINUX kernel — the target
# only decided which numbers the compiler baked in. `SYS_EXIT` resolves to
# the AGNOS value 0, and syscall 0 on Linux is `read`, not `exit`.
#
# That is not theoretical: using SYS_EXIT here made the process fall
# through the exit, re-enter `main()` (the top-level `var x = main();`
# form runs once at global-init and once at entry, and normally the exit
# in between prevents the second), print the whole suite twice, and then
# SIGSEGV. The run reported "30 passed" and exited 139.
#
# So process exit must use the HOST kernel's number. Everything above this
# line is target code and must stay target-correct; this one line is host
# code. `write(2)` is 1 on both, which is why the assert harness itself
# needs no special handling.
#
# Gated on CYRIUS_TARGET_AGNOS (v1.1.4) so scripts/syscall-audit.sh can see
# the number is not arch-blind: this file is only ever built `--agnos`,
# which emits x86_64, and run on an x86_64 Linux host — so 60 is the host's
# exit on the one architecture this build can produce.
#ifdef CYRIUS_TARGET_AGNOS
var HOST_SYS_EXIT = 60;      # Linux x86_64 exit(2) — the runner's kernel
#endif

var exit_code = main();
syscall(HOST_SYS_EXIT, exit_code);
