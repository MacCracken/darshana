# darshana PTY harness — shipped v0.6.0; see CHANGELOG [0.6.0].
#
# The pure-function surface (flag math, escape-byte emit, decimal
# formatting via tty_dec_buf) is
# covered by tests/darshana.tcyr. What that suite *cannot* reach
# under `cyrius test` is the syscall-touching surface — `tty_raw` /
# `tty_cooked` (TCGETS/TCSETS ioctls) and `tty_winsize` — because
# they need a real TTY fd, and the v0.5.0 live-fd tests only fire
# when the runner happens to have a controlling TTY on fd 0 (CI does
# not). This harness manufactures its own TTY: it opens a pseudo-
# terminal, drives darshana against the slave end, and observes the
# results on the master end. That makes the coverage deterministic in
# CI instead of opportunistic.
#
# Skip-clean discipline (matching tests/darshana.tcyr's live-fd
# blocks): every step that touches the kernel is guarded. If a
# sandbox / seccomp policy blocks /dev/ptmx, the unlock ioctl, or the
# slave open, the harness silently stops without faking a pass — the
# consumer-side PTY smoke (cyim / chakshu) still covers the live path
# end-to-end. No read here can block: the master is opened O_NONBLOCK
# and drained through a bounded retry loop, so a wedged kernel buffer
# can never hang the suite.
#
# Linux-only — the whole pty/devpts mechanism (TIOCGPTN, TIOCSPTLCK)
# is Linux ABI. On any other target the body compiles to a single
# skip assertion.

include "src/main.cyr"

#ifdef CYRIUS_TARGET_LINUX

# --- ABI constants this harness depends on (not part of darshana's
# public surface, so defined locally rather than imported). darshana's
# own TCGETS / TCSETS / TIOCGWINSZ / TIO_* come in via src/main.cyr.
# ⛔ ARCH-CORRECTNESS (v1.1.0). Through v1.0.2 this block hardcoded the
# x86_64 numbers — `SYS_ioctl = 16`, `nanosleep = 35`, `dup = 32`,
# `dup2 = 33`, `prlimit64 = 302`, `rt_sigprocmask = 14` — inside a gate
# that is only `CYRIUS_TARGET_LINUX`, which is arch-BLIND. That is the
# v0.9.2 `SYS_IOCTL` defect exactly, living in the harness meant to catch
# it, and it was invisible until v1.1.0 first ran this suite on real
# aarch64: **38 passed, 15 failed**. On aarch64, syscall 16 is
# `fremovexattr`, not `ioctl`, so every TCGETS/TIOCGWINSZ probe here was
# calling the wrong kernel entry point and the failures were reported
# against darshana rather than against the test.
#
# Everything the stdlib defines arch-aware is now taken from the stdlib.
# The two it does not define get an explicit per-arch gate rather than a
# silent x86_64 assumption.
#
#   SYS_IOCTL  16 (x86_64) / 29 (aarch64)  — from lib/syscalls.cyr
#   sys_dup / sys_dup2                     — wrappers; sys_dup2 lowers to
#                                            dup3(old,new,0) on aarch64,
#                                            which has no dup2 at all
#   sys_sigprocmask                        — wrapper; rt_sigprocmask is
#                                            14 (x86_64) / 135 (aarch64)
var PTY_O_RDWR       = 2;
var PTY_O_NOCTTY     = 0x100;       # don't acquire a controlling tty
var PTY_O_NONBLOCK   = 0x800;
var PTY_TIOCGPTN     = 0x80045430;  # _IOR('T',0x30,uint) — slave number
var PTY_TIOCSPTLCK   = 0x40045431;  # _IOW('T',0x31,int)  — (un)lock slave
var PTY_TIOCSWINSZ   = 0x5414;      # set window size
var PTY_ONLCR        = 0x4;         # c_oflag: map \n -> \r\n on output
var PTY_FIONREAD     = 0x541B;      # bytes waiting to be read (v1.3.0)
# nanosleep and prlimit64 have no stdlib constant on either arch, so they
# are gated by hand. Getting these wrong is not harmless: aarch64 syscall
# 35 is `unlinkat`, not `nanosleep`.
#ifdef CYRIUS_ARCH_X86
var PTY_SYS_NANOSLEEP = 35;
var PTY_SYS_PRLIMIT64 = 302;
#endif
#ifdef CYRIUS_ARCH_AARCH64
var PTY_SYS_NANOSLEEP = 101;
var PTY_SYS_PRLIMIT64 = 261;
#endif
var PTY_RLIMIT_NOFILE = 7;          # resource id for the fd ceiling

# Sleep ~1ms. Used between non-blocking master reads so the drain loop
# yields the CPU instead of busy-spinning while the kernel moves bytes
# from the slave's output queue to the master's read queue.
# dup2 with the aarch64 difference handled locally: aarch64 has no dup2
# at all, only dup3(old, new, flags). The stdlib wrapper that does this
# lives in a module outside darshana"s declared footprint, so the two
# lines are inlined here rather than growing the dependency closure for
# a test.
fn _pty_dup2(oldfd, newfd) {
#ifdef CYRIUS_ARCH_X86
    return syscall(SYS_DUP2, oldfd, newfd);
#endif
#ifdef CYRIUS_ARCH_AARCH64
    return syscall(SYS_DUP3, oldfd, newfd, 0);
#endif
}

# Bytes waiting on `fd`'s input queue, or -1 if FIONREAD fails (v1.3.0).
fn _pty_pending(fd) {
    var cnt[8];
    store64(&cnt, 0);
    if (sys_ioctl(fd, PTY_FIONREAD, &cnt) < 0) { return 0 - 1; }
    return tio_load32(&cnt, 0);
}

# Poll until something is waiting on `fd` (bounded, ~200 ms); returns the
# count, or 0 if nothing arrived.
fn _pty_wait_pending(fd) {
    var it = 0;
    while (it < 200) {
        var n = _pty_pending(fd);
        if (n != 0) { return n; }
        _pty_nap();
        it = it + 1;
    }
    return 0;
}

fn _pty_nap() {
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 1000000);      # tv_sec = 0, tv_nsec = 1e6 (1ms)
    syscall(PTY_SYS_NANOSLEEP, &ts, 0);
    return 0;
}

# Read up to `want` bytes from `fd` into `buf`, looping past EAGAIN
# (the master is O_NONBLOCK) until either `want` bytes arrive or the
# iteration cap is hit. Returns the byte count actually collected.
# Bounded by `max_iters` * 1ms so it can never hang.
fn _pty_drain(fd, buf, want, max_iters) {
    var got = 0;
    var it = 0;
    while (got < want && it < max_iters) {
        var n = file_read(fd, buf + got, want - got);
        if (n > 0) {
            got = got + n;
        } else {
            _pty_nap();
        }
        it = it + 1;
    }
    return got;
}

# Discard any bytes already queued on `fd` (non-blocking). Used before
# the escape-capture block so a stray byte from an earlier round-trip
# can't shift the first comparison.
fn _pty_flush(fd) {
    var junk[64];
    var it = 0;
    while (it < 64) {
        var n = file_read(fd, &junk, 64);
        if (n <= 0) { return 0; }
        it = it + 1;
    }
    return 0;
}

# Read exactly `want_len` bytes from `fd` and compare them to the
# `want` byte string. Returns 1 on an exact match, 0 otherwise (wrong
# length or any byte differs). Deliberately assertion-free so it can
# run while fd 1 is redirected — the caller asserts the returned flag
# *after* restoring stdout.
fn _pty_expect(fd, want, want_len) {
    var cap[24];
    var got = _pty_drain(fd, &cap, want_len, 200);
    if (got != want_len) { return 0; }
    var i = 0;
    while (i < want_len) {
        if (load8(&cap + i) != load8(want + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Emit a grep-able skip marker to stdout. Every branch that bails
# because the kernel denied a pty step prints one of these, so a
# degraded run (sandbox / seccomp / no devpts) is VISIBLY distinct
# from a fully-green run instead of silently reporting "0 passed". CI
# greps for "SKIP pty:" and annotates a warning. Skip markers are NOT
# assertions — they neither pass nor fail the suite.
fn _pty_skip(reason) {
    sys_write(1, "SKIP pty: ", 10);
    sys_write(1, reason, strlen(reason));
    sys_write(1, "\n", 1);
    return 0;
}

#endif

fn main() {
    alloc_init();

#ifdef CYRIUS_TARGET_LINUX

    # ----- PTY setup -------------------------------------------------
    # open("/dev/ptmx", O_RDWR|O_NOCTTY|O_NONBLOCK) → master.
    test_group("pty.tcyr — open pseudo-terminal");
    var master_closed = 0;           # the hangup group (v1.1.4) closes it early
    var master = sys_open("/dev/ptmx",
        PTY_O_RDWR | PTY_O_NOCTTY | PTY_O_NONBLOCK, 0);
    if (master >= 0) {
        # Unlock the slave: ioctl(master, TIOCSPTLCK, &0).
        var lockarg[4];
        store8(&lockarg + 0, 0); store8(&lockarg + 1, 0);
        store8(&lockarg + 2, 0); store8(&lockarg + 3, 0);
        var unlk = syscall(SYS_IOCTL, master, PTY_TIOCSPTLCK, &lockarg);

        # Fetch the slave number: ioctl(master, TIOCGPTN, &n).
        var ptnbuf[4];
        store8(&ptnbuf + 0, 0); store8(&ptnbuf + 1, 0);
        store8(&ptnbuf + 2, 0); store8(&ptnbuf + 3, 0);
        var gptn = syscall(SYS_IOCTL, master, PTY_TIOCGPTN, &ptnbuf);

        if (unlk >= 0 && gptn >= 0) {
            var ptn = tio_load32(&ptnbuf, 0);

            # Build "/dev/pts/<ptn>\0" — reuse darshana's own decimal
            # formatter (tty_dec_buf) for the number.
            var path[32];
            store8(&path + 0, 0x2f); store8(&path + 1, 0x64);   # '/' 'd'
            store8(&path + 2, 0x65); store8(&path + 3, 0x76);   # 'e' 'v'
            store8(&path + 4, 0x2f); store8(&path + 5, 0x70);   # '/' 'p'
            store8(&path + 6, 0x74); store8(&path + 7, 0x73);   # 't' 's'
            store8(&path + 8, 0x2f);                            # '/'
            # tty_dec_buf returns the new end position, so the NUL goes
            # exactly there.
            var pend = tty_dec_buf(&path, 9, ptn);
            store8(&path + pend, 0);                            # NUL

            var slave = sys_open(&path, PTY_O_RDWR | PTY_O_NOCTTY, 0);
            if (slave >= 0) {
                assert(slave >= 0, "slave /dev/pts/N opened");

                # ----- tty_isatty against a known-live TTY -----------
                # Deterministic here (the fd-0 test in darshana.tcyr is
                # not — it depends on the runner having a tty).
                test_group("pty.tcyr — tty_isatty (live slave)");
                assert_eq(tty_isatty(slave), 1, "slave fd is a TTY");
                # Deterministic negative half of the predicate (F32):
                # /dev/null is never a TTY, so tty_isatty must return 0.
                # Pairs with the guaranteed-positive slave above to pin
                # both arms of the 1/0 contract in one place (the fd-0
                # test in darshana.tcyr is runner-dependent).
                var dn = sys_open("/dev/null", PTY_O_RDWR, 0);
                if (dn >= 0) {
                    assert_eq(tty_isatty(dn), 0, "/dev/null is not a TTY (isatty=0)");
                    file_close(dn);
                }

                # ----- tty_winsize set/get round-trip ----------------
                # Set a known geometry on the slave, read it back via
                # darshana. Exercises the TIOCGWINSZ path with a value
                # we control rather than whatever the host terminal is.
                test_group("pty.tcyr — tty_winsize set/get");
                var wsset[8];
                var wi = 0;
                while (wi < 8) { store8(&wsset + wi, 0); wi = wi + 1; }
                store8(&wsset + 0, 24);    # row = 24 (u16 LE)
                store8(&wsset + 2, 80);    # col = 80 (u16 LE)
                var wsrc = syscall(SYS_IOCTL, slave, PTY_TIOCSWINSZ, &wsset);
                if (wsrc >= 0) {
                    var rows = 0;
                    var cols = 0;
                    assert_eq(tty_winsize(slave, &rows, &cols), 0,
                        "tty_winsize succeeds on live slave");
                    assert_eq(rows, 24, "tty_winsize read back rows = 24");
                    assert_eq(cols, 80, "tty_winsize read back cols = 80");

                    # v1.2.0 — tty_winsize_or: the real size when there is
                    # one; the caller's default for the "successful zero".
                    test_group("pty.tcyr — tty_winsize_or (v1.2.0)");
                    var wo_r = 0;
                    var wo_c = 0;
                    assert_eq(tty_winsize_or(slave, &wo_r, &wo_c, 25, 81), 0, "winsize_or returns 0");
                    assert_eq(wo_r, 24, "winsize_or: a real size wins over the default (rows)");
                    assert_eq(wo_c, 80, "winsize_or: a real size wins over the default (cols)");
                    var wszero[8];
                    store64(&wszero, 0);
                    if (syscall(SYS_IOCTL, slave, PTY_TIOCSWINSZ, &wszero) >= 0) {
                        assert_eq(tty_winsize(slave, &rows, &cols), 0, "a 0x0 pty still answers TIOCGWINSZ successfully");
                        assert_eq(rows + cols, 0, "...with 0 rows and 0 cols — the case winsize_or exists for");
                        tty_winsize_or(slave, &wo_r, &wo_c, 25, 81);
                        assert_eq(wo_r, 25, "winsize_or: 0x0 → the default rows");
                        assert_eq(wo_c, 81, "winsize_or: 0x0 → the default cols");
                        syscall(SYS_IOCTL, slave, PTY_TIOCSWINSZ, &wsset);   # back to 24x80
                    }
                    var wo_dn = sys_open("/dev/null", 2, 0);
                    if (wo_dn >= 0) {
                        tty_winsize_or(wo_dn, &wo_r, &wo_c, 25, 81);
                        assert_eq(wo_r * 1000 + wo_c, 25081, "winsize_or: a non-TTY → both defaults");
                        file_close(wo_dn);
                    }
                }

                # ----- u16 HIGH-BYTE decode (v1.0.2) -----------------
                # 24x80 fits in one byte per field, so the geometry
                # above exercises only `load8(&ws + 0)` and
                # `load8(&ws + 2)` — the `| (load8(&ws + 1) << 8)` and
                # `| (load8(&ws + 3) << 8)` halves of the decode were
                # never run by any test. A dropped shift, a wrong
                # offset, or a swapped rows/cols pair would all have
                # shipped green. Pick values whose high AND low bytes
                # are both non-zero and DIFFERENT from each other, so
                # a byte-order or field-swap error cannot coincide
                # with the expected answer.
                #   rows = 0x0123 =  291   cols = 0x0456 = 1110
                var wsbig[8];
                var wbi = 0;
                while (wbi < 8) { store8(&wsbig + wbi, 0); wbi = wbi + 1; }
                store8(&wsbig + 0, 0x23);   # row low
                store8(&wsbig + 1, 0x01);   # row high
                store8(&wsbig + 2, 0x56);   # col low
                store8(&wsbig + 3, 0x04);   # col high
                # Non-zero pixel fields too: tty_winsize must ignore
                # them, not fold them into the counts.
                store8(&wsbig + 4, 0xFF);
                store8(&wsbig + 5, 0xFF);
                store8(&wsbig + 6, 0xFF);
                store8(&wsbig + 7, 0xFF);
                var wsrc2 = syscall(SYS_IOCTL, slave, PTY_TIOCSWINSZ, &wsbig);
                if (wsrc2 >= 0) {
                    var brows = 0;
                    var bcols = 0;
                    assert_eq(tty_winsize(slave, &brows, &bcols), 0,
                        "tty_winsize succeeds on a multi-byte geometry");
                    assert_eq(brows, 291,  "u16 high byte decoded for rows (0x0123)");
                    assert_eq(bcols, 1110, "u16 high byte decoded for cols (0x0456)");
                    # Restore the sane geometry for anything downstream.
                    syscall(SYS_IOCTL, slave, PTY_TIOCSWINSZ, &wsset);
                }

                # ----- tty_winsize_px (v1.7.0) -----------------------
                # The pixel fields read back. As above, every field's
                # high and low bytes are non-zero and differ, and the
                # fields differ from each other, so a dropped shift, a
                # wrong offset or a swapped pair cannot land on the
                # expected answer:
                #   xpix = 0x0789 = 1929   ypix = 0x0ABC = 2748
                test_group("pty.tcyr — tty_winsize_px (v1.7.0)");
                var wspx[8];
                store8(&wspx + 0, 0x23); store8(&wspx + 1, 0x01);   # row  0x0123
                store8(&wspx + 2, 0x56); store8(&wspx + 3, 0x04);   # col  0x0456
                store8(&wspx + 4, 0x89); store8(&wspx + 5, 0x07);   # xpix 0x0789
                store8(&wspx + 6, 0xBC); store8(&wspx + 7, 0x0A);   # ypix 0x0ABC
                if (syscall(SYS_IOCTL, slave, PTY_TIOCSWINSZ, &wspx) >= 0) {
                    var pr = 0;
                    var pc = 0;
                    var pxw = 0;
                    var pxh = 0;
                    assert_eq(tty_winsize_px(slave, &pr, &pc, &pxw, &pxh), 0,
                        "tty_winsize_px succeeds on live slave");
                    assert_eq(pr * 10000 + pc, 2911110, "rows and cols decoded as tty_winsize does (291, 1110)");
                    assert_eq(pxw, 1929, "pixel width is the u16 at offset 4 (0x0789)");
                    assert_eq(pxh, 2748, "pixel height is the u16 at offset 6 (0x0ABC)");
                    var tr = 0;
                    var tc = 0;
                    tty_winsize(slave, &tr, &tc);
                    assert_eq(tr * 10000 + tc, pr * 10000 + pc, "tty_winsize reads the same rows and cols");
                    # 24 x 80 with the pixel fields 0 (wsset): none reported.
                    syscall(SYS_IOCTL, slave, PTY_TIOCSWINSZ, &wsset);
                    pxw = 7;
                    pxh = 7;
                    assert_eq(tty_winsize_px(slave, &pr, &pc, &pxw, &pxh), 0,
                        "a window with no pixel size still answers");
                    assert_eq(pr * 1000 + pc, 24080, "...24 x 80");
                    assert_eq(pxw + pxh, 0, "...and 0 x 0 pixels, written, not left as they were");
                }

                # ----- tty_winsize / tty_isatty failure path ---------
                # v1.0.2. Both are documented to fail on a non-TTY fd,
                # and neither had a test for it: tty_winsize's -1 return
                # was asserted nowhere, and tty_isatty's 0 verdict was
                # only checked against /dev/null in the group above.
                # Use a freshly opened /dev/null — a definitively
                # non-TTY, definitively OPEN descriptor, so this
                # distinguishes "not a terminal" from "bad fd".
                test_group("pty.tcyr — tty_winsize on a non-TTY (v1.0.2)");
                var dn2 = sys_open("/dev/null", PTY_O_RDWR, 0);
                if (dn2 >= 0) {
                    var nrows = 12345;
                    var ncols = 54321;
                    assert_eq(tty_winsize(dn2, &nrows, &ncols), 0 - 1,
                        "tty_winsize returns -1 on a live non-TTY fd");
                    assert_eq(nrows, 12345, "tty_winsize leaves out_rows untouched on failure");
                    assert_eq(ncols, 54321, "tty_winsize leaves out_cols untouched on failure");
                    var nxp = 777;
                    var nyp = 888;
                    assert_eq(tty_winsize_px(dn2, &nrows, &ncols, &nxp, &nyp), 0 - 1,
                        "tty_winsize_px returns -1 on a live non-TTY fd (v1.7.0)");
                    assert_eq(nrows * 100000 + ncols, 1234554321, "tty_winsize_px leaves rows and cols untouched on failure");
                    assert_eq(nxp * 1000 + nyp, 777888, "...and both pixel out-pointers");
                    file_close(dn2);
                }

                # ----- state-restore round-trip ----------------------
                # The ADR-0002 guarantee: tty_raw must save cooked-mode
                # termios and tty_cooked must put it back byte-for-byte.
                # Snapshot → raw → assert raw mask applied → cooked →
                # assert exact restoration. Buffers are zeroed first so
                # the 24 trailing pad bytes (kernel writes 36 of 60)
                # compare deterministically.
                test_group("pty.tcyr — tty_raw applies raw mask");
                var snap[60];
                var raw[60];
                var rest[60];
                var zi = 0;
                while (zi < 60) {
                    store8(&snap + zi, 0);
                    store8(&raw + zi, 0);
                    store8(&rest + zi, 0);
                    zi = zi + 1;
                }
                var snrc = syscall(SYS_IOCTL, slave, TCGETS, &snap);
                if (snrc >= 0) {
                    assert_eq(tty_raw(slave), 0, "tty_raw succeeds on slave");
                    syscall(SYS_IOCTL, slave, TCGETS, &raw);
                    # lflag (off 12) — interactive bits cleared.
                    var lf = tio_load32(&raw, 12);
                    assert_eq(lf & TIO_ECHO,   0, "ECHO cleared in raw");
                    assert_eq(lf & TIO_ICANON, 0, "ICANON cleared in raw");
                    assert_eq(lf & TIO_ISIG,   0, "ISIG cleared in raw");
                    assert_eq(lf & TIO_IEXTEN, 0, "IEXTEN cleared in raw");
                    # oflag (off 4) — post-processing off.
                    assert_eq(tio_load32(&raw, 4) & TIO_OPOST, 0,
                        "OPOST cleared in raw");
                    # cflag (off 8) — 8-bit chars.
                    assert_eq(tio_load32(&raw, 8) & TIO_CS8, TIO_CS8,
                        "CS8 set in raw");
                    # c_cc — byte-at-a-time, no timeout.
                    assert_eq(load8(&raw + TIO_CC_BASE + TIO_VMIN),  1,
                        "VMIN = 1 in raw");
                    assert_eq(load8(&raw + TIO_CC_BASE + TIO_VTIME), 0,
                        "VTIME = 0 in raw");
                    # iflag (off 0) — v1.1.4. A real pty's cooked iflag has
                    # ICRNL | IXON set, so these bits are live here; through
                    # v1.1.3 nothing asserted them on a real terminal, and a
                    # regression in iflag clearing would have passed.
                    var ifl = tio_load32(&raw, 0);
                    assert_eq(ifl & TIO_BRKINT, 0, "BRKINT cleared in raw");
                    assert_eq(ifl & TIO_ICRNL,  0, "ICRNL cleared in raw");
                    assert_eq(ifl & TIO_INPCK,  0, "INPCK cleared in raw");
                    assert_eq(ifl & TIO_ISTRIP, 0, "ISTRIP cleared in raw");
                    assert_eq(ifl & TIO_IXON,   0, "IXON cleared in raw");

                    # ----- behavioral output round-trip (raw) --------
                    # With OPOST off, "\n" passes through untranslated.
                    # Write A\nB to the slave, read it on the master:
                    # exactly 3 bytes, no CR injected.
                    test_group("pty.tcyr — raw output round-trip (no CRLF)");
                    var rmsg[3];
                    store8(&rmsg + 0, 0x41);   # 'A'
                    store8(&rmsg + 1, 0x0a);   # '\n'
                    store8(&rmsg + 2, 0x42);   # 'B'
                    file_write(slave, &rmsg, 3);
                    var rrd[8];
                    # Once we hold a real pty slave, the round-trip MUST
                    # complete — a zero-byte drain is a regression, not a
                    # skip, so these assert unconditionally. The 1000-iter
                    # (≈1s) cap keeps it unhangable while giving a loaded
                    # CI runner ample margin to flush slave→master.
                    var rgot = _pty_drain(master, &rrd, 3, 1000);
                    assert_eq(rgot, 3, "raw: master read 3 bytes (no CRLF)");
                    assert_eq(load8(&rrd + 0), 0x41, "raw byte 0 = 'A'");
                    assert_eq(load8(&rrd + 1), 0x0a, "raw byte 1 = '\\n' (untranslated)");
                    assert_eq(load8(&rrd + 2), 0x42, "raw byte 2 = 'B'");

                    # ----- restore -----------------------------------
                    test_group("pty.tcyr — tty_cooked restores termios");
                    assert_eq(tty_cooked(), 0, "tty_cooked succeeds");
                    syscall(SYS_IOCTL, slave, TCGETS, &rest);
                    var diff = 0;
                    var ci = 0;
                    while (ci < 60) {
                        if (load8(&rest + ci) != load8(&snap + ci)) {
                            diff = diff + 1;
                        }
                        ci = ci + 1;
                    }
                    assert_eq(diff, 0,
                        "termios restored byte-for-byte after tty_cooked");

                    # ----- behavioral output round-trip (cooked) -----
                    # Back in cooked mode OPOST|ONLCR is on, so a lone
                    # "\n" becomes "\r\n". Same write, master now sees 4
                    # bytes — the mirror image of the raw assertion above,
                    # confirming the restore re-enabled post-processing.
                    test_group("pty.tcyr — cooked output round-trip (CRLF)");
                    # The CRLF expectation is only valid if the restored
                    # cooked termios actually has OPOST|ONLCR — assert that
                    # against the snapshot so the test justifies its own
                    # expectation rather than assuming the pty default.
                    assert_eq(tio_load32(&snap, 4) & (TIO_OPOST | PTY_ONLCR),
                        TIO_OPOST | PTY_ONLCR,
                        "snap oflag has OPOST|ONLCR (justifies CRLF)");
                    var cmsg[3];
                    store8(&cmsg + 0, 0x41);   # 'A'
                    store8(&cmsg + 1, 0x0a);   # '\n'
                    store8(&cmsg + 2, 0x42);   # 'B'
                    file_write(slave, &cmsg, 3);
                    var crd[8];
                    var cgot = _pty_drain(master, &crd, 4, 1000);
                    assert_eq(cgot, 4, "cooked: master read 4 bytes (CRLF)");
                    assert_eq(load8(&crd + 0), 0x41, "cooked byte 0 = 'A'");
                    assert_eq(load8(&crd + 1), 0x0d, "cooked byte 1 = '\\r' (injected)");
                    assert_eq(load8(&crd + 2), 0x0a, "cooked byte 2 = '\\n'");
                    assert_eq(load8(&crd + 3), 0x42, "cooked byte 3 = 'B'");
                }

                # ----- escape-emitting surface via fd-1 capture ------
                # tty_clear / tty_move / tty_cursor_* / tty_alt_* /
                # tty_sgr all write their CSI escape straight to fd 1.
                # The unit suite can only reach the _buf twins and the
                # rejection paths — never these actual fd-1 bytes. Here
                # we dup the slave onto fd 1 (slave in raw mode, so
                # OPOST can't rewrite the sequence), call each helper,
                # and read the escape back off the master. Captures land
                # in flags while redirected; no test_group / assert_eq
                # (both touch fd 1 / fd 2) runs until stdout is restored.
                var saved1 = syscall(SYS_DUP, 1);
                if (saved1 >= 0) {
                    tty_raw(slave);
                    _pty_dup2(slave, 1);
                    _pty_flush(master);

                    tty_alt_enter();
                    var e_alte = _pty_expect(master, "\x1b[?1049h", 8);
                    tty_alt_leave();
                    var e_altl = _pty_expect(master, "\x1b[?1049l", 8);
                    tty_clear();
                    var e_clr  = _pty_expect(master, "\x1b[2J", 4);
                    tty_clear_to_eol();
                    var e_ceol = _pty_expect(master, "\x1b[K", 3);
                    tty_clear_to_eos();
                    var e_cend = _pty_expect(master, "\x1b[J", 3);
                    tty_cursor_hide();
                    var e_chid = _pty_expect(master, "\x1b[?25l", 6);
                    tty_cursor_show();
                    var e_csho = _pty_expect(master, "\x1b[?25h", 6);
                    tty_cursor_home();
                    var e_chom = _pty_expect(master, "\x1b[H", 3);
                    tty_move(3, 5);
                    var e_mov  = _pty_expect(master, "\x1b[3;5H", 6);
                    tty_cursor_up(2);
                    var e_up   = _pty_expect(master, "\x1b[2A", 4);
                    tty_cursor_down(4);
                    var e_dn   = _pty_expect(master, "\x1b[4B", 4);
                    tty_sgr(31);
                    var e_sgr  = _pty_expect(master, "\x1b[31m", 5);
                    tty_sgr_reset();
                    var e_rst  = _pty_expect(master, "\x1b[0m", 4);
                    # Direct (fd-1) truecolor writers — only their _buf
                    # twins + rejection paths are unit-tested; this drives
                    # the real write(2) + the composers' inline 3-digit branch.
                    tty_fg_rgb(255, 0, 128);
                    var e_fgr  = _pty_expect(master, "\x1b[38;2;255;0;128m", 17);
                    tty_bg_rgb(1, 22, 200);
                    var e_bgr  = _pty_expect(master, "\x1b[48;2;1;22;200m", 16);

                    # Restore stdout BEFORE any assert / test_group.
                    _pty_dup2(saved1, 1);
                    file_close(saved1);
                    tty_cooked();

                    test_group("pty.tcyr — escape emission (fd-1 capture)");
                    assert_eq(e_alte, 1, "tty_alt_enter emits CSI ?1049h");
                    assert_eq(e_altl, 1, "tty_alt_leave emits CSI ?1049l");
                    assert_eq(e_clr,  1, "tty_clear emits CSI 2J");
                    assert_eq(e_ceol, 1, "tty_clear_to_eol emits CSI K");
                    assert_eq(e_cend, 1, "tty_clear_to_eos emits CSI J");
                    assert_eq(e_chid, 1, "tty_cursor_hide emits CSI ?25l");
                    assert_eq(e_csho, 1, "tty_cursor_show emits CSI ?25h");
                    assert_eq(e_chom, 1, "tty_cursor_home emits CSI H");
                    assert_eq(e_mov,  1, "tty_move(3,5) emits CSI 3;5H");
                    assert_eq(e_up,   1, "tty_cursor_up(2) emits CSI 2A");
                    assert_eq(e_dn,   1, "tty_cursor_down(4) emits CSI 4B");
                    assert_eq(e_sgr,  1, "tty_sgr(31) emits CSI 31m");
                    assert_eq(e_rst,  1, "tty_sgr_reset emits CSI 0m");
                    assert_eq(e_fgr,  1, "tty_fg_rgb(255,0,128) emits CSI 38;2;255;0;128m");
                    assert_eq(e_bgr,  1, "tty_bg_rgb(1,22,200) emits CSI 48;2;1;22;200m");
                }

                # ----- single-raw-fd model (F01a) --------------------
                # tty_cooked() is zero-arg and restores the fd tty_raw
                # saved. A second tty_raw on a DIFFERENT fd while already
                # raw is refused with -1, not silently honored — the lone
                # saved-state slot can only restore one fd. Runs last
                # (slave is restored + closed right after).
                test_group("pty.tcyr — single-raw-fd model");
                assert_eq(tty_raw(slave), 0, "tty_raw(slave) enters raw");
                assert_eq(tty_raw(slave), 0, "tty_raw(slave) again idempotent (same fd)");
                assert_eq(tty_raw(master), 0 - 1, "tty_raw(master) refused while slave raw");
                assert_eq(tty_cooked(), 0, "tty_cooked() restores the saved fd");
                assert_eq(tty_cooked(), 0, "tty_cooked() again is a no-op");
                # v1.1.4 — tty_cooked() RELEASES the slot: the same fd can go
                # raw again for real, not just get the same-fd "already raw"
                # success. Checked through TCGETS, because the return value
                # alone cannot tell the two apart — through v1.1.3 a
                # tty_cooked() that forgot to clear the slot passed here.
                assert_eq(tty_raw(slave), 0, "tty_raw(slave) again after cooked");
                var rr_t[60];
                syscall(SYS_IOCTL, slave, TCGETS, &rr_t);
                assert_eq(tio_load32(&rr_t, 12) & TIO_ECHO, 0, "...and the slave really is raw again (ECHO clear)");
                assert_eq(tty_cooked(), 0, "tty_cooked() after the re-raw");

                # v1.2.0 — tty_raw_nonblock: the raw mask with VMIN = 0 and
                # VTIME = 0, the same slot, the same restore, and a mode
                # switch on the fd that holds the slot.
                test_group("pty.tcyr — tty_raw_nonblock (v1.2.0)");
                var nb_snap[60];
                var nb_now[60];
                var nbi = 0;
                while (nbi < 60) { store8(&nb_snap + nbi, 0); store8(&nb_now + nbi, 0); nbi = nbi + 1; }
                syscall(SYS_IOCTL, slave, TCGETS, &nb_snap);
                assert_eq(tty_raw_nonblock(slave), 0, "tty_raw_nonblock(slave) enters raw");
                syscall(SYS_IOCTL, slave, TCGETS, &nb_now);
                assert_eq(load8(&nb_now + TIO_CC_BASE + TIO_VMIN), 0, "non-blocking raw: VMIN = 0");
                assert_eq(load8(&nb_now + TIO_CC_BASE + TIO_VTIME), 0, "non-blocking raw: VTIME = 0");
                assert_eq(tio_load32(&nb_now, 12) & TIO_ECHO, 0, "non-blocking raw: the raw mask applies (ECHO clear)");
                if (load8(&nb_now + TIO_CC_BASE + TIO_VMIN) == 0) {
                    # Only safe because VMIN = 0 was just asserted — with
                    # VMIN = 1 this read would block rather than fail.
                    var nb_b[4];
                    assert_eq(sys_read(slave, &nb_b, 1), 0, "a read with nothing waiting returns 0 at once");
                }
                assert_eq(tty_raw_nonblock(master), 0 - 1, "a different fd is refused while the slot is held");
                assert_eq(tty_raw(slave), 0, "tty_raw on the same fd switches to blocking reads");
                syscall(SYS_IOCTL, slave, TCGETS, &nb_now);
                assert_eq(load8(&nb_now + TIO_CC_BASE + TIO_VMIN), 1, "...VMIN back to 1");
                assert_eq(tty_raw_nonblock(slave), 0, "and back to non-blocking");
                syscall(SYS_IOCTL, slave, TCGETS, &nb_now);
                assert_eq(load8(&nb_now + TIO_CC_BASE + TIO_VMIN), 0, "...VMIN 0 again");
                assert_eq(tty_raw_nonblock(slave + (1 << 32)), 0 - 1, "an out-of-range fd is refused");
                assert_eq(tty_cooked(), 0, "tty_cooked() restores from either mode");
                syscall(SYS_IOCTL, slave, TCGETS, &nb_now);
                var nb_diff = 0;
                nbi = 0;
                while (nbi < 60) { if (load8(&nb_now + nbi) != load8(&nb_snap + nbi)) { nb_diff = nb_diff + 1; } nbi = nbi + 1; }
                assert_eq(nb_diff, 0, "termios restored byte-for-byte after the mode switches");

                # v1.3.0 — tty_flush_input: typeahead the terminal holds is
                # discarded, without touching the slot.
                test_group("pty.tcyr — tty_flush_input (v1.3.0)");
                file_write(master, "abc\n", 4);
                assert(_pty_wait_pending(slave) > 0, "fixture: typed input is waiting on the slave");
                assert_eq(tty_flush_input(slave), 0, "tty_flush_input(slave) = 0");
                assert_eq(_pty_pending(slave), 0, "nothing is waiting after the flush");
                assert_eq(_tty_in_raw, 0, "the flush took no slot");
                _pty_flush(master);                     # drop the echo of "abc"

                # v1.3.0 — tty_echo_off: ECHO and ECHONL off, line editing on,
                # pending input discarded, the same slot and restore.
                test_group("pty.tcyr — tty_echo_off (v1.3.0)");
                var eo_snap[60];
                var eo_now[60];
                var eoi = 0;
                while (eoi < 60) { store8(&eo_snap + eoi, 0); store8(&eo_now + eoi, 0); eoi = eoi + 1; }
                # A pty starts with ECHONL off, so clearing it would prove
                # nothing: turn it on first, and put the original back after.
                var eo_orig[60];
                sys_ioctl(slave, TCGETS, &eo_orig);
                sys_ioctl(slave, TCGETS, &eo_now);
                tio_store32(&eo_now, 12, tio_load32(&eo_now, 12) | _TIO_ECHONL);
                sys_ioctl(slave, TCSETS, &eo_now);
                sys_ioctl(slave, TCGETS, &eo_snap);
                var eo_want = tio_load32(&eo_snap, 12) & ~(TIO_ECHO | _TIO_ECHONL);
                file_write(master, "pw\n", 3);
                assert(_pty_wait_pending(slave) > 0, "fixture: typeahead is waiting before the prompt");
                _pty_flush(master);
                assert_eq(tty_echo_off(slave), 0, "tty_echo_off(slave) = 0");
                assert_eq(_pty_pending(slave), 0, "the typeahead was discarded (TCSETSF)");
                sys_ioctl(slave, TCGETS, &eo_now);
                assert_eq(tio_load32(&eo_now, 12), eo_want, "c_lflag is the cooked one minus ECHO and ECHONL");
                assert_eq(tio_load32(&eo_now, 12) & TIO_ICANON, TIO_ICANON, "line editing stays on (ICANON)");
                assert_eq(tio_load32(&eo_now, 12) & _TIO_ECHONL, 0, "ECHONL off, though the cooked state had it on");
                var eo_other = 0;
                eoi = 0;
                while (eoi < 60) {
                    if (eoi < 12 || eoi > 15) { if (load8(&eo_now + eoi) != load8(&eo_snap + eoi)) { eo_other = eo_other + 1; } }
                    eoi = eoi + 1;
                }
                assert_eq(eo_other, 0, "nothing but c_lflag changed");
                file_write(master, "s3cret\n", 7);
                assert(_pty_wait_pending(slave) > 0, "fixture: the typed line arrived");
                var eo_echo[16];
                assert_eq(_pty_drain(master, &eo_echo, 16, 30), 0, "the typed line is not echoed back");
                var eo_line[16];
                assert_eq(sys_read(slave, &eo_line, 16), 7, "the whole line is read, newline included");
                assert_eq(tty_echo_off(slave), 0, "a repeat on the same fd is a no-op success");
                assert_eq(tty_echo_off(master), 0 - 1, "a different fd is refused while the slot is held");
                assert_eq(tty_raw(slave), 0, "tty_raw on the same fd switches to raw");
                sys_ioctl(slave, TCGETS, &eo_now);
                assert_eq(tio_load32(&eo_now, 12) & TIO_ICANON, 0, "...ICANON off in raw");
                assert_eq(tty_echo_off(slave), 0, "and back to echo-off");
                sys_ioctl(slave, TCGETS, &eo_now);
                assert_eq(tio_load32(&eo_now, 12), eo_want, "...re-derived from the saved cooked state");
                assert_eq(tty_cooked(), 0, "tty_cooked() restores from echo-off");
                sys_ioctl(slave, TCGETS, &eo_now);
                var eo_diff = 0;
                eoi = 0;
                while (eoi < 60) { if (load8(&eo_now + eoi) != load8(&eo_snap + eoi)) { eo_diff = eo_diff + 1; } eoi = eoi + 1; }
                assert_eq(eo_diff, 0, "termios restored byte-for-byte after echo-off");
                sys_ioctl(slave, TCSETS, &eo_orig);     # undo the ECHONL fixture

                # v1.1.4 — the kernel reads an fd as a 32-bit unsigned int,
                # so through v1.1.3 any i64 outside [0, 0x7FFFFFFF] aliased
                # the descriptor in its low 32 bits.
                test_group("pty.tcyr — out-of-range fds never alias a live fd (v1.1.4)");
                var hi32 = 1 << 32;
                var imin = 1 << 63;
                assert_eq(tty_isatty(slave + hi32), 0, "isatty(slave + 2^32) = 0, not slave's verdict");
                assert_eq(tty_isatty(imin + slave), 0, "isatty(i64min + slave) = 0");
                assert_eq(tty_isatty(slave - hi32), 0, "isatty(slave - 2^32) = 0 (negative)");
                var ar = 0;
                var ac = 0;
                assert_eq(tty_winsize(slave + hi32, &ar, &ac), 0 - 1, "winsize(slave + 2^32) = -1");
                var axp = 0;
                var ayp = 0;
                assert_eq(tty_winsize_px(slave + hi32, &ar, &ac, &axp, &ayp), 0 - 1, "winsize_px(slave + 2^32) = -1 (v1.7.0)");
                assert_eq(tty_raw(slave + hi32), 0 - 1, "tty_raw(slave + 2^32) = -1, slave not taken raw");
                assert_eq(tty_raw(slave), 0, "tty_raw(slave) still succeeds after the rejected alias");
                assert_eq(tty_cooked(), 0, "tty_cooked() after the alias test");
                var alias_dn = sys_open("/dev/null", 2, 0);
                if (alias_dn >= 0) {
                    tty_close_signalfd(alias_dn + hi32, 0);
                    var dnb[8];
                    assert_eq(file_read(alias_dn, &dnb, 1), 0,
                        "close_signalfd(alias_dn + 2^32) did not close the live alias_dn");
                    # A failed tty_raw leaves no state behind (documented):
                    # /dev/null is not a TTY, so TCGETS fails, and the slot
                    # stays free for the real terminal.
                    assert_eq(tty_raw(alias_dn), 0 - 1, "tty_raw(/dev/null) = -1");
                    assert_eq(tty_raw(slave), 0, "the failed raw left no state: slave can go raw");
                    assert_eq(tty_cooked(), 0, "tty_cooked() after the failed-raw check");
                    file_close(alias_dn);
                }

                # Hangup — the documented permanent-failure path, run LAST
                # because it closes the master. With the master gone,
                # TCSETS on the slave fails (EIO), tty_cooked() returns -1,
                # and the single raw slot stays stranded: tty_raw on any
                # other fd is refused (ADR 0003's knowingly-frozen
                # imperfection). The private flag is cleared afterwards so
                # the remaining groups start clean — tests share the unit.
                test_group("pty.tcyr — hangup strands the raw slot (documented)");
                assert_eq(tty_raw(slave), 0, "tty_raw(slave) before hangup");
                file_close(master);
                master_closed = 1;
                # A mode switch on the fd that holds the slot skips TCGETS (the
                # cooked state is already saved), so this is the one call whose
                # TCSETS can fail alone — and after the hangup it does (EIO).
                # It must be refused, not recorded (v1.3.0: dropping the TCSETS
                # check passed every suite through 1.2.1).
                assert_eq(tty_raw_nonblock(slave), 0 - 1, "a mode switch whose TCSETS fails returns -1");
                assert_eq(_tty_mode, _TTY_RAW, "the refused switch leaves the recorded mode unchanged");
                assert_eq(tty_cooked(), 0 - 1, "tty_cooked() = -1 after the master hangs up");
                assert_eq(_tty_in_raw, 1, "the slot stays held after a failed restore");
                var hup_dn = sys_open("/dev/null", 2, 0);
                if (hup_dn >= 0) {
                    assert_eq(tty_raw(hup_dn), 0 - 1, "a different fd is refused while the slot is stranded");
                    file_close(hup_dn);
                }
                # v1.3.0 — tty_forget frees the stranded slot without a restore.
                assert_eq(tty_forget(), 0, "tty_forget() = 0 on a stranded slot");
                assert_eq(_tty_in_raw, 0, "the slot is free again");
                assert_eq(tty_cooked(), 0, "tty_cooked() is the no-op success once nothing is held");

                file_close(slave);
            } else {
                _pty_skip("slave /dev/pts open blocked");
            }
        } else {
            _pty_skip("TIOCSPTLCK/TIOCGPTN ioctl blocked");
        }
        if (master_closed == 0) { file_close(master); }
    } else {
        # /dev/ptmx unavailable (seccomp / minimal container). The
        # consumer-side PTY smoke covers the live path; emit a skip
        # marker (not a faked-pass assertion) so the degraded run is
        # visible to CI's SKIP grep instead of silently green.
        _pty_skip("/dev/ptmx unavailable");
    }

    # --- tty_open_signalfd failure path (deterministic) ------------
    #
    # v0.9.3. The success path is covered opportunistically in
    # tests/darshana.tcyr; the FAILURE path is the one that carried a
    # defect through v0.9.2, and it can be forced deterministically by
    # squeezing RLIMIT_NOFILE so signalfd(2) cannot allocate an fd.
    #
    # Pre-fix behavior (reproduced under RLIMIT_NOFILE=3): the call
    # returned the raw -errno (-24/EMFILE) instead of -1, AND left the
    # signals in `sigmask` blocked on the thread forever — the caller
    # got no fd, so it had nothing to hand `tty_close_signalfd`. A
    # consumer following the documented "degrade gracefully" advice
    # then ran its whole session deaf to the signals it had blocked.
    test_group("pty.tcyr — tty_open_signalfd failure path");
    var sig_before[8];
    store64(&sig_before, 0);
    sys_sigprocmask(0, 0, &sig_before);

    var rl_old[16];
    store64(&rl_old, 0);
    store64(&rl_old + 8, 0);
    var rl_rc = syscall(PTY_SYS_PRLIMIT64, 0, PTY_RLIMIT_NOFILE, 0, &rl_old);
    if (rl_rc == 0) {
        # Drop the ceiling to 3 — fds 0/1/2 only, so no new fd can be
        # allocated. rlim_max is left at its old value so the raise
        # back at the end is permitted for an unprivileged process.
        var rl_new[16];
        store64(&rl_new, 3);
        store64(&rl_new + 8, load64(&rl_old + 8));
        if (syscall(PTY_SYS_PRLIMIT64, 0, PTY_RLIMIT_NOFILE, &rl_new, 0) == 0) {
            var fsfd = tty_open_signalfd(TTY_SIGMASK_WINCH);

            # Restore the ceiling BEFORE asserting, so a failed
            # assertion can still open files on the way out.
            syscall(PTY_SYS_PRLIMIT64, 0, PTY_RLIMIT_NOFILE, &rl_old, 0);

            var sig_after[8];
            store64(&sig_after, 0);
            sys_sigprocmask(0, 0, &sig_after);

            if (fsfd >= 0) {
                # The squeeze did not take (fd ceiling not actually
                # binding here). Don't fake a pass — clean up and skip.
                tty_close_signalfd(fsfd, TTY_SIGMASK_WINCH);
                _pty_skip("RLIMIT_NOFILE squeeze did not force signalfd failure");
            } else {
                assert_eq(fsfd, 0 - 1,
                    "forced-failure open returns exactly -1, not a raw -errno");
                assert_eq(load64(&sig_after) & TTY_SIGMASK_WINCH, 0,
                    "forced-failure open leaves no SIG_BLOCK residue");
                assert_eq(load64(&sig_after), load64(&sig_before),
                    "thread signal mask is byte-identical to before the call");
            }
        } else {
            _pty_skip("prlimit64 set blocked — cannot force signalfd failure");
        }
    } else {
        _pty_skip("prlimit64 get blocked — cannot force signalfd failure");
    }

#endif

#ifndef CYRIUS_TARGET_LINUX
    test_group("pty.tcyr — non-Linux");
    assert_eq(1, 1, "pty harness is Linux-only — skipped on this target");
#endif

    return assert_summary();
}

var pty_exit = main();
# SYS_EXIT, not the literal 60 — see tests/darshana.tcyr's note.
syscall(SYS_EXIT, pty_exit);
