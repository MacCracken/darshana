[package]
name = "darshana"
version = "${file:VERSION}"
description = "दर्शन — viewing/showing. Linux TTY/raw-mode primitives (termios, ANSI, cursor) for AGNOS first-party tools (cyim, chakshu, ...)."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.20"

[build]
entry = "programs/smoke.cyr"
output = "build/darshana-smoke"

[lib]
# `cyrius distlib` concatenates these, in order, into dist/darshana.cyr.
# src/main.cyr is deliberately absent: it includes all four for the tests
# and smoke, and listing it would duplicate every module body in the bundle.
modules = ["src/termios.cyr", "src/ansi.cyr", "src/cursor.cyr", "src/sanitize.cyr"]

[deps]
# darshana's own build footprint, tests and smoke included (`assert` is
# test-only). Consumers do not inherit it: dist/darshana.deps is derived
# by `cyrius distlib`'s compile-verify.
#
# lib/ is output — rebuild it with `rm -rf lib/ && cyrius deps`.
stdlib = ["syscalls", "alloc", "io", "assert"]
---
