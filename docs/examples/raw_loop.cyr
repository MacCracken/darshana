# raw_loop.cyr — the ADR 0002 teardown shape, end to end.
#
# This is the example to copy from. It takes the terminal raw, moves to
# the alt-screen, runs a redraw loop driven by a signalfd, and restores
# EVERYTHING on every exit path — normal quit, SIGINT/SIGTERM/SIGHUP,
# and the error paths in between.
#
# Build + run from the project root:
#
#     cyrius build docs/examples/raw_loop.cyr build/raw-loop
#     ./build/raw-loop
#
# Press q or Ctrl-C to exit; resize the window to see SIGWINCH handled.
# Without a controlling TTY (CI, a pipe) it prints one line and exits 0,
# so it is safe to run anywhere.
#
# ---------------------------------------------------------------------
# NOTE ON THE INCLUDE. In-tree examples pull `src/main.cyr`. A real
# consumer declares darshana in its own `cyrius.cyml`:
#
#     [deps.darshana]
#     git     = "https://github.com/MacCracken/darshana.git"
#     tag     = "0.9.4"
#     modules = ["dist/darshana.cyr"]
#
# and then writes `include "lib/darshana.cyr"` after `cyrius deps`.
# Everything below the include line is identical either way.
# ---------------------------------------------------------------------

include "src/main.cyr"

#ifdef CYRIUS_TARGET_LINUX

# poll(2) — x86_64 SYS_poll. Used instead of a blocking read so the
# loop can wait on the signalfd and stdin at the same time. A consumer
# already running an epoll loop wires the signalfd into that instead;
# darshana does not care which readiness mechanism you use.
var EX_SYS_POLL = 7;
var EX_POLLIN   = 1;

# struct pollfd { i32 fd; i16 events; i16 revents; } — 8 bytes.
# NUL-terminated write to fd 1. The stdlib `print` takes an explicit
# length; this saves counting bytes by hand in the draw routine.
fn ex_print(str) {
    var n = 0;
    while (load8(str + n) != 0) { n = n + 1; }
    print(str, n);
    return 0;
}

fn ex_pollfd_set(buf, slot, fd, events) {
    var off = slot * 8;
    store8(buf + off,     fd & 0xFF);
    store8(buf + off + 1, (fd >> 8) & 0xFF);
    store8(buf + off + 2, (fd >> 16) & 0xFF);
    store8(buf + off + 3, (fd >> 24) & 0xFF);
    store8(buf + off + 4, events & 0xFF);
    store8(buf + off + 5, (events >> 8) & 0xFF);
    store8(buf + off + 6, 0);
    store8(buf + off + 7, 0);
    return 0;
}

fn ex_pollfd_revents(buf, slot) {
    var off = slot * 8;
    return load8(buf + off + 6) | (load8(buf + off + 7) << 8);
}

# ---- teardown -------------------------------------------------------
#
# THE WHOLE POINT OF THIS EXAMPLE. The order is ADR 0002's, and it is
# not arbitrary:
#
#   1. tty_cursor_show()  — or the user's shell prompt comes back with
#                           an invisible cursor.
#   2. tty_alt_leave()    — restore the primary screen. Do this BEFORE
#                           resetting colors so the reset lands on the
#                           screen the user is actually left looking at.
#   3. tty_sgr_reset()    — only needed if you emitted any SGR.
#   4. tty_cooked()       — line discipline back. Zero-arg: it restores
#                           onto the fd tty_raw saved.
#   5. tty_close_signalfd() — closes the fd AND unblocks the signals.
#                           Closing the fd alone leaves them blocked.
#
# Every step is idempotent, so calling this from two different exit
# paths is safe. That is deliberate — see ADR 0002.
fn ex_teardown(sfd, mask) {
    tty_cursor_show();
    tty_alt_leave();
    tty_sgr_reset();
    tty_cooked();
    if (sfd >= 0) { tty_close_signalfd(sfd, mask); }
    return 0;
}

fn ex_draw(frame) {
    var rows = 0;
    var cols = 0;
    if (tty_winsize(0, &rows, &cols) < 0) { rows = 24; cols = 80; }

    tty_clear();
    tty_move(1, 1);
    tty_fg_rgb(120, 200, 255);
    ex_print("darshana raw_loop — q or Ctrl-C to quit");
    tty_sgr_reset();

    tty_move(3, 1);
    ex_print("terminal: ");
    fmt_int(cols);
    ex_print(" cols x ");
    fmt_int(rows);
    ex_print(" rows");

    tty_move(4, 1);
    ex_print("frames drawn: ");
    fmt_int(frame);

    # Anchor something at the bottom edge to prove the winsize query is
    # live — this line moves when you resize the window.
    tty_move(rows, 1);
    tty_fg_rgb(90, 90, 90);
    ex_print("bottom row = ");
    fmt_int(rows);
    tty_sgr_reset();
    return 0;
}

fn main() {
    # 1. Refuse to take over something that is not a terminal. Without
    #    this, running under a pipe or in CI would emit escape bytes
    #    into whatever is downstream.
    if (tty_isatty(0) == 0) {
        println("raw_loop: stdin is not a TTY — nothing to drive, exiting cleanly.");
        return 0;
    }

    # 2. Open the signalfd BEFORE going raw. If this fails we have not
    #    touched the terminal yet, so there is nothing to unwind.
    #    As of v0.9.3 a failed open returns exactly -1 and leaves no
    #    signal-mask residue behind, so degrading here is clean.
    var mask = TTY_SIGMASK_EXIT | TTY_SIGMASK_WINCH;
    var sfd = tty_open_signalfd(mask);
    if (sfd < 0) {
        # Degrade rather than refuse to launch: no signal-driven exit,
        # but 'q' still works. This is the documented posture.
        println("raw_loop: signalfd unavailable — continuing without signal handling.");
        sfd = 0 - 1;
    }

    # 3. Go raw. If THIS fails, unwind the signalfd — the one thing we
    #    have already acquired.
    if (tty_raw(0) < 0) {
        println("raw_loop: could not enter raw mode.");
        if (sfd >= 0) { tty_close_signalfd(sfd, mask); }
        return 1;
    }

    # 4. Now the screen. From here on, every exit path goes through
    #    ex_teardown().
    tty_alt_enter();
    tty_cursor_hide();

    var frame = 0;
    var running = 1;
    ex_draw(frame);

    var pfds[16];          # two pollfd slots
    var buf[8];

    while (running == 1) {
        ex_pollfd_set(&pfds, 0, 0, EX_POLLIN);          # stdin
        var nfds = 1;
        if (sfd >= 0) {
            ex_pollfd_set(&pfds, 1, sfd, EX_POLLIN);    # signalfd
            nfds = 2;
        }

        # -1 = block indefinitely. A real render loop with a periodic
        # refresh passes a timeout here instead.
        var rc = syscall(EX_SYS_POLL, &pfds, nfds, 0 - 1);
        if (rc < 0) { running = 0; }

        if (running == 1) {
            if ((ex_pollfd_revents(&pfds, 0) & EX_POLLIN) != 0) {
                # Raw mode means one keystroke = one byte, no Enter.
                var n = sys_read(0, &buf, 1);
                if (n <= 0) { running = 0; }
                else {
                    var key = load8(&buf);
                    # 'q' or Ctrl-C-as-a-byte. ISIG is cleared by
                    # tty_raw, so Ctrl-C arrives here as 0x03 rather
                    # than as a signal — unless it came via the
                    # signalfd below, which is why both are handled.
                    if (key == 113 || key == 3) { running = 0; }
                    else {
                        frame = frame + 1;
                        ex_draw(frame);
                    }
                }
            }

            if (sfd >= 0) {
                if ((ex_pollfd_revents(&pfds, 1) & EX_POLLIN) != 0) {
                    # A signalfd_siginfo is 128 bytes; we only need to
                    # know that SOMETHING arrived, then re-read the
                    # window size. A consumer that must distinguish
                    # WINCH from TERM reads the full struct and checks
                    # its ssi_signo field at offset 0.
                    var sig[128];
                    var sn = sys_read(sfd, &sig, 128);
                    if (sn > 0) {
                        var signo = load8(&sig);
                        # SIGWINCH = 28 — redraw at the new size.
                        if (signo == 28) {
                            frame = frame + 1;
                            ex_draw(frame);
                        } else {
                            # HUP/INT/TERM — leave the loop and restore.
                            running = 0;
                        }
                    }
                }
            }
        }
    }

    # 5. One teardown, reached by every path out of the loop.
    ex_teardown(sfd, mask);
    println("raw_loop: terminal restored.");
    return 0;
}

#endif

#ifndef CYRIUS_TARGET_LINUX
fn main() {
    # tty_raw returns -1 on AGNOS (no termios), so a full-screen raw
    # loop cannot run there yet — the honest thing is to say so rather
    # than spin on input that never arrives.
    println("raw_loop: Linux-only (raw mode needs termios).");
    return 0;
}
#endif

var ex_code = main();
syscall(60, ex_code);
