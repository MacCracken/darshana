# sanitize.cyr — making untrusted bytes safe to put on the terminal (v1.2.0).
#
# A tool that prints text it did not write — a filename, a process's
# cmdline, a log line, a peer's chat message — hands the terminal whatever
# control sequences that text contains: a CSI that recolours or repaints
# the screen, an OSC that retitles the window or rewrites the clipboard, a
# DCS that some terminals act on. Neutralizing those bytes is the one
# output-safety primitive every screen-owning tool needs, and before v1.2.0
# seven darshana consumers and nine other AGNOS projects each wrote their
# own — four consumer rules read in full, all four different, two of them
# letting C1 controls through. It joined darshana's charter by owner ruling
# (2026-10-12); the design is recorded in docs/adr/0004.
#
# Pure: no syscall, no platform gate, no allocation.

# Sanitizing modes for `tty_sanitize_buf`. UTF8 keeps valid UTF-8 text
# byte-for-byte and neutralizes everything a terminal could read as a
# control, including C1 controls in their encoded form; LATIN1 treats the
# input as single-byte text and neutralizes every raw 0x80-0x9F byte, which
# a Latin-1 terminal reads as a C1 control — but which are also ordinary
# UTF-8 continuation bytes, so LATIN1 breaks UTF-8 text (`€` is E2 82 AC).
# Choose the mode for the terminal the output is going to, not the data.
var TTY_SANITIZE_UTF8   = 0;
var TTY_SANITIZE_LATIN1 = 1;

# `keep` bits for `tty_sanitize_buf`: C0 bytes the caller wants to pass
# through instead of neutralizing — TAB in a table cell, LF in multi-line
# text. Bit N keeps byte N, for N in 0..31; these two are the ones
# consumers keep. ESC (27) can never be kept, whatever `keep` says.
var TTY_KEEP_TAB = 0x200;               # 1 << 9
var TTY_KEEP_LF  = 0x400;               # 1 << 10

# The replacement for every neutralized byte or sequence: '?'.
var _SAN_REPL = 63;

# Append a sanitized copy of `len` bytes at `src` to `buf` at `pos`.
# Returns the new write position, or -1 if `pos` or `len` is negative or
# `mode` is neither TTY_SANITIZE_UTF8 nor TTY_SANITIZE_LATIN1; a rejection
# writes nothing. Byte budget: at most `len` — every neutralized input
# byte or sequence becomes ONE '?', so the output is never longer than the
# input, and `buf + pos == src` (sanitizing in place) is safe. Any other
# overlap of the two ranges is undefined.
#
# Neutralized, in both modes: every C0 control byte (0x00-0x1F) except the
# ones `keep` names — and never ESC (0x1B) — and DEL (0x7F).
#
# TTY_SANITIZE_UTF8 also neutralizes C1 controls written as UTF-8
# (U+0080-U+009F, C2 80-C2 9F) as one '?' each, and every byte that is not
# part of a well-formed UTF-8 sequence (RFC 3629: no overlong forms, no
# surrogates, nothing above U+10FFFF, no stray continuation byte, no
# sequence cut off by the end of the input). A malformed sequence is
# replaced one byte at a time: its first byte becomes '?' and decoding
# resumes at the next byte. Everything else — printable ASCII and every
# well-formed non-C1 code point — is copied unchanged, so text with
# nothing to neutralize comes out byte-for-byte identical.
#
# TTY_SANITIZE_LATIN1 also neutralizes every raw byte 0x80-0x9F, and
# copies 0xA0-0xFF unchanged; it is one byte in, one byte out.
#
# Output is idempotent: sanitizing it again with the same `mode` and
# `keep` changes nothing.
#
# Not neutralized: Unicode format characters such as bidirectional
# overrides (U+202A-U+202E, U+2066-U+2069). Terminals do not execute them
# as controls; reordering displayed text is a different threat.
fn tty_sanitize_buf(buf, pos, src, len, mode, keep) {
    if (pos < 0 || len < 0) { return 0 - 1; }
    if (mode != TTY_SANITIZE_UTF8 && mode != TTY_SANITIZE_LATIN1) { return 0 - 1; }
    var p = buf + pos;
    var i = 0;
    while (i < len) {
        var c = load8(src + i);
        if (c < 0x80) {
            if (c < 0x20) {
                if (c != 27 && ((keep >> c) & 1) == 1) { store8(p, c); }
                else { store8(p, _SAN_REPL); }
            } else {
                if (c == 0x7F) { store8(p, _SAN_REPL); } else { store8(p, c); }
            }
            p = p + 1;
            i = i + 1;
        } else {
            if (mode == TTY_SANITIZE_LATIN1) {
                if (c < 0xA0) { store8(p, _SAN_REPL); } else { store8(p, c); }
                p = p + 1;
                i = i + 1;
            } else {
                var n = _san_utf8_len(src + i, len - i);
                if (n == 0) {
                    store8(p, _SAN_REPL);          # malformed: neutralize one byte, resync
                    p = p + 1;
                    i = i + 1;
                } else {
                    if (n == 2 && c == 0xC2 && load8(src + i + 1) < 0xA0) {
                        store8(p, _SAN_REPL);      # encoded C1, U+0080-U+009F
                        p = p + 1;
                    } else {
                        var k = 0;
                        while (k < n) { store8(p + k, load8(src + i + k)); k = k + 1; }
                        p = p + n;
                    }
                    i = i + n;
                }
            }
        }
    }
    return p - buf;
}

# Length of the well-formed UTF-8 sequence starting at `s` (lead byte
# >= 0x80), with `avail` bytes available — 2, 3 or 4 — or 0 if the bytes
# there are not a well-formed sequence. The table is RFC 3629 §4: each
# lead byte fixes the sequence length AND the range of its second byte,
# which is what excludes overlong forms (E0 80-9F, F0 80-8F), surrogates
# (ED A0-BF) and code points above U+10FFFF (F4 90-BF, and F5-FF leads).
# C0 and C1 are never valid leads (they could only start overlong forms),
# and 80-BF are continuation bytes, never leads.
fn _san_utf8_len(s, avail) {
    var c = load8(s);
    var n = 0;
    var lo = 0x80;
    var hi = 0xBF;
    if (c >= 0xC2 && c <= 0xDF) { n = 2; }
    if (c == 0xE0) { n = 3; lo = 0xA0; }
    if (c >= 0xE1 && c <= 0xEC) { n = 3; }
    if (c == 0xED) { n = 3; hi = 0x9F; }
    if (c >= 0xEE && c <= 0xEF) { n = 3; }
    if (c == 0xF0) { n = 4; lo = 0x90; }
    if (c >= 0xF1 && c <= 0xF3) { n = 4; }
    if (c == 0xF4) { n = 4; hi = 0x8F; }
    if (n == 0 || n > avail) { return 0; }
    var c1 = load8(s + 1);
    if (c1 < lo || c1 > hi) { return 0; }
    var k = 2;
    while (k < n) {
        var ck = load8(s + k);
        if (ck < 0x80 || ck > 0xBF) { return 0; }
        k = k + 1;
    }
    return n;
}
