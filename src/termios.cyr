# =====================================================================
# darshana — public surface conventions (frozen at v1.0)
# =====================================================================
#
# This header leads `dist/darshana.cyr`, the single-file bundle consumers
# include. It documents the whole library surface, not just this module.
# Per-module and per-function detail follows each symbol below.
#
# Naming conventions (frozen at v1.0):
#   tty_*  public functions        tio_*  termios LE field codec
#   TIO_*  termios bit flags        TTY_*  darshana-defined constants
#   TIOC*  raw kernel ioctl nums    _*     private-by-convention
#                                          (in the bundle, not the API)
#
# Return conventions. Every public fn falls in exactly one of these
# five buckets. (Four through v1.0.1 — which left `tio_load32`,
# `tio_store32` and `tty_close_signalfd` in none of them while the
# sentence claimed all 29 were covered. The codec bucket is the fix.)
#   • validating side-effecting ops — tty_raw, tty_raw_nonblock,
#     tty_echo_off, tty_cooked, tty_flush_input, tty_winsize, tty_move,
#     tty_scroll_region, tty_sgr, tty_sgr_list, tty_fg_rgb, tty_bg_rgb,
#     tty_title, tty_clipboard_set — 0 on success, -1 on failure or
#     out-of-range reject (rejected before any byte reaches fd 1).
#   • unconditional ops — the emitters tty_alt_enter/leave, tty_clear,
#     tty_clear_to_eol/eos, tty_cursor_hide/show/home,
#     tty_cursor_save/restore, tty_sgr_reset, tty_cursor_up/down,
#     tty_scroll_region_reset, tty_mouse_enable/disable,
#     tty_paste_enable/disable, plus tty_winsize_or and tty_forget —
#     ALWAYS 0. The write(2) result is not checked (rationale in ansi.cyr's
#     header). `n <= 0` on tty_cursor_up/down is a documented no-op, not a
#     reject: these never return -1.
#   • `_buf` composers (tty_dec_buf, tty_sgr_buf, tty_sgr_list_buf,
#     tty_sgr_reset_buf, tty_fg_rgb_buf, tty_bg_rgb_buf, tty_fg_256_buf,
#     tty_bg_256_buf, tty_move_buf, tty_clear_to_eol_buf, tty_title_buf,
#     tty_clipboard_buf, tty_sanitize_buf) — the new write position, or -1
#     on out-of-range input OR on a negative incoming `pos` — so a -1 from
#     an earlier link poisons the rest of the chain rather than being
#     laundered into a write below the buffer. tty_dec_buf additionally
#     clamps `val <= 0` to a single '0'. Each composer documents its own
#     byte budget; none takes a capacity argument, so sizing the buffer is
#     the caller's job. tty_sgr_strip_buf (v1.4.0) is the in-place member:
#     it has no `pos`, never writes past the `n` bytes it was given, and
#     returns how many it kept, or -1 on a negative `n` or a `final`
#     other than 0 or 1.
#   • predicates / scanners / fd openers / readers — tty_isatty and
#     tty_isatty_is_per_fd (v1.6.0) return 1/0; tty_has_ctl 1/0, or -1 on
#     bad arguments; tty_sgr_len (v1.4.0)
#     the length of the SGR at its offset, 0 when the bytes there are not
#     one (or the arguments are out of contract), and -1 when the buffer
#     ends before that is decided, which is not a failure;
#     tty_open_signalfd returns an fd (>= 0) or exactly -1, never a raw
#     -errno; tty_read_signal the signal number, 0 when none is pending,
#     or -1. tty_close_signalfd is
#     the teardown counterpart: 0 on success, exactly -1 on failure (also
#     never a raw -errno — normalized in v1.0.2; see its docstring).
#   • termios field codec — tio_load32 returns the zero-extended
#     32-bit field at `off` (never negative, never a failure code);
#     tio_store32 always returns 0. Neither bounds-checks: `buf` and
#     `off` are the caller's contract, deliberately (ADR 0003 records
#     this as knowingly frozen in). They are the only two public fns
#     with no failure mode at all.
#
# Modules in this bundle, by concern:
#   termios.cyr  — termios modes (raw, non-blocking raw, echo-off) and
#                  their restore, input flush, winsize, isatty, signalfd,
#                  TIO_*
#   ansi.cyr     — alt-screen / clear / cursor visibility and save /
#                  SGR color / mouse and paste modes / OSC title and
#                  clipboard / reading SGR in text (v1.4.0)
#   cursor.cyr   — tty_dec_buf (decimal formatter), cursor positioning,
#                  scroll region
#   sanitize.cyr — making untrusted bytes safe for the terminal (v1.2.0)
#
# Symbols prefixed `_` are private by convention — they ship in this
# bundle because it is one compilation unit, but they are NOT public
# surface and may change without a major bump. The authoritative public
# list is `scripts/smoke.sh` (`required_syms` / `required_flags`), which
# CI checks against this bundle in both directions.
#
# =====================================================================

# termios.cyr — Linux raw-mode TTY (TCGETS/TCSETS via ioctl).
#
# Donor port from cyim/src/tty.cyr — verbatim functional behavior, split
# into this file (termios) + ansi.cyr + cursor.cyr per darshana's M1 plan.
# Preserves cyim's public symbol names (tty_raw, tty_cooked, ...) so the
# Phase 4 cyim migration is just a manifest change, not a rename.
#
# Linux kernel termios layout. The kernel's `struct termios` is 36 bytes —
# exactly what TCGETS copies out and TCSETS reads in; darshana's 60-byte
# buffers match glibc's padded userspace struct and leave the tail as
# slack. x86_64 and aarch64 Linux share this layout via
# asm-generic/termbits.h:
#
#   off  0  c_iflag   i32   input modes
#   off  4  c_oflag   i32   output modes
#   off  8  c_cflag   i32   control modes
#   off 12  c_lflag   i32   local modes
#   off 16  c_line     u8   line discipline
#   off 17  c_cc[19]   u8   special chars (VTIME @ 22, VMIN @ 23)
#
# macOS (BSD) termios is a different struct and is deliberately out of
# scope (CLAUDE.md domain rules; roadmap.md §"Out of scope") — add it
# when a real consumer needs it, not before.
# The ioctl wrappers below gate to CYRIUS_TARGET_LINUX. ANSI / cursor
# helpers (in ansi.cyr / cursor.cyr) work on any vt100-compatible
# terminal, so the platform gate sits at the syscall boundary, not at
# darshana's surface.

# Termios bit flags (asm-generic/termbits.h; matches x86_64 and aarch64 Linux).
var TIO_ECHO   = 0x008;
var TIO_ICANON = 0x002;
var TIO_ISIG   = 0x001;
var TIO_IEXTEN = 0x8000;
var TIO_ICRNL  = 0x100;
var TIO_IXON   = 0x400;
var TIO_OPOST  = 0x001;
var TIO_CSIZE  = 0x030;
var TIO_CS8    = 0x030;
var TIO_BRKINT = 0x002;
var TIO_INPCK  = 0x010;
var TIO_ISTRIP = 0x020;

# Special-char indices into c_cc[] (relative to start of c_cc, which sits at offset 17).
var TIO_CC_BASE  = 17;
var TIO_VTIME    = 5;
var TIO_VMIN     = 6;

# Termios buffer size. The kernel struct is 36 bytes active, but the ioctl
# write tolerates any size >= 36; 60 covers the historically padded variants
# without straddling a stack red-zone.
#
# Exposed as the canonical name for callers ioctling TCGETS/TCSETS directly
# (e.g., a consumer that wants to read termios state without taking it raw).
# Cyrius requires array sizes to be literals or enum constants, not `var`
# constants, so the internal `_tty_saved[60]` and `work[60]` declarations
# below use the matching literal. If this value ever changes, all three
# sites (this constant and the two arrays) must move together. (`tty_raw`'s
# copy loop was a fourth literal `60` through v1.1.4; it reads this
# constant since v1.2.0.)
var TIO_BUF_SIZE = 60;

# Read the 32-bit little-endian field at byte offset `off` inside the
# termios buffer `buf`. Returns the field value as a non-negative
# integer in [0, 0xFFFFFFFF] — the four bytes are zero-extended, never
# sign-extended, so a flag word with the top bit set reads as a large
# positive number rather than a negative one.
#
# Public because a consumer may want to read termios state without
# taking the terminal raw: ioctl `TCGETS` into a `TIO_BUF_SIZE` buffer
# and pull fields out with this. Offsets are the kernel struct's —
# c_iflag 0, c_oflag 4, c_cflag 8, c_lflag 12 (layout table at the top
# of this file).
#
# NO bounds check: `buf` and `off` are the caller's contract. Reading at
# an `off` beyond the buffer reads adjacent memory.
fn tio_load32(buf, off) {
    var b0 = load8(buf + off);
    var b1 = load8(buf + off + 1);
    var b2 = load8(buf + off + 2);
    var b3 = load8(buf + off + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

# Write `val` as a 32-bit little-endian field at byte offset `off`
# inside the termios buffer `buf`. Only the low 32 bits of `val` are
# stored; higher bits are discarded, not an error. Always returns 0 —
# there is no failure mode.
#
# Same caller contract as `tio_load32`: NO bounds check, so an `off`
# beyond the buffer corrupts adjacent memory. Pair it with `tio_load32`
# for a read-modify-write against a `TCGETS` snapshot.
fn tio_store32(buf, off, val) {
    store8(buf + off,     val & 0xFF);
    store8(buf + off + 1, (val >> 8) & 0xFF);
    store8(buf + off + 2, (val >> 16) & 0xFF);
    store8(buf + off + 3, (val >> 24) & 0xFF);
    return 0;
}

# Apply darshana's raw-mode flag mask in place to a 60-byte termios buffer.
# The bit-twiddling half of `tty_raw` extracted as a pure function so it
# can be unit-tested without owning a real TTY fd.
#
# Private (`_`-prefixed) — internal to `tty_raw`, NOT part of darshana's
# public surface. Privatized in v0.7.0: it bakes in darshana's specific
# raw-mode mask, so no consumer has a reason to call it directly, and a
# same-compilation-unit test can still reach it. The pure-function
# split exists for testability, not for the API.
#
# Cleared:
#   c_iflag: BRKINT | ICRNL | INPCK | ISTRIP | IXON
#   c_oflag: OPOST              (post-processing off — \n stays \n)
#   c_lflag: ECHO | ICANON | IEXTEN | ISIG    (key-by-key, no signals)
# Set:
#   c_cflag: CS8                 (8-bit chars; CSIZE cleared first)
#   c_cc[VMIN]  = 1              (read returns after one byte)
#   c_cc[VTIME] = 0              (no read timeout)
#
# ISIG is cleared so Ctrl-C / Ctrl-Z reach the consumer as bytes —
# matches vim convention. Consumers that want kernel signal handling
# (chakshu's render loop is not one of them yet) should clone the
# saved cooked-mode termios and patch c_lflag themselves.
fn _tty_apply_raw_flags(buf) {
    var iflag = tio_load32(buf, 0);
    iflag = iflag & ~(TIO_BRKINT | TIO_ICRNL | TIO_INPCK | TIO_ISTRIP | TIO_IXON);
    tio_store32(buf, 0, iflag);

    var oflag = tio_load32(buf, 4);
    oflag = oflag & ~TIO_OPOST;
    tio_store32(buf, 4, oflag);

    var cflag = tio_load32(buf, 8);
    cflag = (cflag & ~TIO_CSIZE) | TIO_CS8;
    tio_store32(buf, 8, cflag);

    var lflag = tio_load32(buf, 12);
    lflag = lflag & ~(TIO_ECHO | TIO_ICANON | TIO_IEXTEN | TIO_ISIG);
    tio_store32(buf, 12, lflag);

    store8(buf + TIO_CC_BASE + TIO_VMIN, 1);
    store8(buf + TIO_CC_BASE + TIO_VTIME, 0);
    return 0;
}

#ifdef CYRIUS_TARGET_LINUX

# `SYS_IOCTL` is deliberately NOT defined here. Since v1.2.0 darshana
# calls the stdlib's `sys_ioctl` wrapper (`lib/syscalls_linux_common.cyr`,
# filed by kybernet, whose own comment cites this file), which issues the
# stdlib's arch-aware `SYS_IOCTL`: 16 on x86_64, 29 on aarch64. This gate is `CYRIUS_TARGET_LINUX`, which is
# arch-BLIND, so a local `var SYS_IOCTL = 16` shadowed the stdlib's value
# on aarch64 (last definition wins) and every ioctl below issued 16 —
# which on aarch64-Linux is `fremovexattr`, not `ioctl`. Through cyrius
# 6.5.37 the ELF aarch64 backend's ESYSXLAT chain had no 16→29 row, and
# its "syscall not routed" warning is Mach-O-only, so the wrong number
# passed through silently. Fixed here in v0.9.2. cyrius 6.5.38 added a
# 16→29 row in response, but the backend translates only SOME x86_64
# numbers, so never rely on it: do not reintroduce a local definition.
#
# The ioctl *request* codes below stay local: they are arch-stable across
# both Linux targets (asm-generic/ioctls.h — x86_64's asm/ioctls.h is a
# bare include of it) and the stdlib does not define them.
# ioctl request codes for reading and writing termios. Public surface:
# a consumer that wants termios state without going raw does
# `sys_ioctl(fd, TCGETS, &buf)` with a `TIO_BUF_SIZE` buffer, and can
# write it back with `TCSETS`. Arch-stable across both Linux
# targets (asm-generic/ioctls.h).
#
# Writing termios yourself is outside darshana's state-restore model:
# `tty_cooked()` restores only what `tty_raw` saved, so a consumer that
# TCSETS behind darshana's back owns undoing it. See ADR 0002.
var TCGETS = 0x5401;
var TCSETS = 0x5402;

# Window-size query — `struct winsize { u16 row, u16 col, u16 xpix, u16 ypix } = 8 bytes`.
# v0.3.0 — added for chakshu's M2 Slice D dynamic resize.
var TIOCGWINSZ = 0x5413;

# Common signal masks for `tty_open_signalfd` — Linux sigset_t is one
# u64 with bit (signum - 1) set per signal in the mask.
#   TTY_SIGMASK_EXIT  = SIGHUP(1) | SIGINT(2) | SIGTERM(15) → bits 0,1,14 → 0x4003
#   TTY_SIGMASK_WINCH = SIGWINCH(28)                         → bit  27     → 0x08000000
#   TTY_SIGMASK_PIPE  = SIGPIPE(13)                          → bit  12     → 0x1000
# Callers can OR these or build custom masks; the primitive itself is
# mask-agnostic. v0.3.0 — promoted from chakshu's _tui_open_exit_signalfd.
#
# TTY_SIGMASK_PIPE (v1.3.0): a write to a pipe whose reader has gone raises
# SIGPIPE, whose default action kills the process mid-teardown (ADR 0002).
# Blocking it through a signalfd turns that into a readable event and the
# write into an EPIPE return. The three masks are disjoint, so each can have
# its own signalfd.
var TTY_SIGMASK_EXIT  = 0x4003;
var TTY_SIGMASK_WINCH = 0x08000000;
var TTY_SIGMASK_PIPE  = 0x1000;

# Saved cooked-mode termios. Populated on `tty_raw`; consumed by `tty_cooked`.
# Module-global rather than caller-owned so any exit path (including
# signal handlers and panic paths) can reach it for cleanup without
# threading state. The literal `60` mirrors `TIO_BUF_SIZE` — see that
# constant's docstring for why the duplication exists.
var _tty_saved[60];
var _tty_in_raw = 0;
# The fd `tty_raw` saved state for. There is exactly one saved-state
# slot (`_tty_saved`), so darshana tracks exactly one raw fd at a time;
# `tty_cooked()` restores onto this fd. v0.7.0 — added so `tty_cooked`
# could drop its (previously misleading) fd parameter.
var _tty_raw_fd = 0;

# 1 if `fd` is a value the kernel will read as THAT fd, 0 otherwise.
#
# Private (v1.1.4). Linux takes a file descriptor as an `unsigned int`, so
# the kernel reads only the low 32 bits of the i64 a caller passes. Through
# v1.1.3 the four fd-taking Linux peers forwarded any i64, so a value
# outside [0, 0x7FFFFFFF] silently ALIASED a different descriptor:
# `tty_isatty(fd + 2^32)` answered 1 for a number that is no open fd,
# `tty_raw(fd + 2^32)` took `fd` raw (and then refused `tty_raw(fd)` on the
# same terminal), and `tty_close_signalfd(fd + 2^32, mask)` closed an
# unrelated live `fd`. Every docstring promises a verdict about the fd the
# caller named, so rejecting the alias makes behaviour match the contract.
# The bound is INT_MAX: the kernel's fd table is indexed by int.
fn _tty_fd_ok(fd) {
    if (fd < 0 || fd > 0x7FFFFFFF) { return 0; }
    return 1;
}

# The mode the slot's fd is in while `_tty_in_raw` is 1 (v1.3.0; through
# 1.2.1 this was `_tty_raw_vmin`, the raw VMIN): raw with blocking reads
# (`tty_raw`), raw with reads that return at once (`tty_raw_nonblock`), or
# cooked with echo off (`tty_echo_off`). All three share the one save slot,
# so `tty_cooked()` restores whichever is on.
const _TTY_RAW    = 1;
const _TTY_RAW_NB = 2;
const _TTY_NOECHO = 3;
var _tty_mode = _TTY_RAW;

# ioctl requests and flags only the slot's modes and `tty_flush_input` use.
# Arch-stable across both Linux targets (asm-generic/ioctls.h, termbits.h).
const _TCSETSF    = 0x5404;    # TCSETS, discarding unread input first
const _TCFLSH     = 0x540B;
const _TCIFLUSH   = 0;         # TCFLSH argument: the input queue
const _TIO_ECHONL = 0x040;     # c_lflag: echo NL even when ECHO is off

# Shared body of `tty_raw`, `tty_raw_nonblock` and `tty_echo_off`.
# Private (v1.2.0 as `_tty_raw_mode`; v1.3.0 gained the echo-off mode).
# Enters a mode from cooked, saving the cooked termios; or, on the fd that
# already holds the slot, switches between modes by re-deriving from the
# SAVED cooked state, which it never overwrites — so `tty_cooked()`
# restores exactly, whichever mode is on. A same-fd call in the mode
# already applied is a no-op success, exactly as `tty_raw` has always
# been. Returns 0, or -1.
fn _tty_set_mode(fd, mode) {
    if (_tty_fd_ok(fd) == 0) { return 0 - 1; }
    if (_tty_in_raw == 1) {
        if (fd != _tty_raw_fd) { return 0 - 1; }
        if (mode == _tty_mode) { return 0; }
    } else {
        if (sys_ioctl(fd, TCGETS, &_tty_saved) < 0) { return 0 - 1; }
    }

    var work[60];                       # size mirrors TIO_BUF_SIZE
    var i = 0;
    while (i < TIO_BUF_SIZE) {
        store8(&work + i, load8(&_tty_saved + i));
        i = i + 1;
    }
    var req = TCSETS;
    if (mode == _TTY_NOECHO) {
        # Line editing stays on (ICANON); only what the user types is no
        # longer shown, including the newline that ends the line.
        tio_store32(&work, 12, tio_load32(&work, 12) & ~(TIO_ECHO | _TIO_ECHONL));
        req = _TCSETSF;
    } else {
        # _tty_apply_raw_flags sets VMIN = 1 / VTIME = 0: tty_raw's bytes.
        _tty_apply_raw_flags(&work);
        if (mode == _TTY_RAW_NB) { store8(&work + TIO_CC_BASE + TIO_VMIN, 0); }
    }

    if (sys_ioctl(fd, req, &work) < 0) { return 0 - 1; }
    _tty_raw_fd = fd;
    _tty_in_raw = 1;
    _tty_mode = mode;
    return 0;
}

# Enter raw mode on `fd`. Saves the current termios so `tty_cooked()`
# can restore it, and records `fd` as the owning raw fd. Returns 0 on
# success, -1 on ioctl failure (most often: fd is not a TTY).
#
# Single-raw-fd model: there is one saved-state slot, so only one fd
# can be raw at a time. A second call while already raw on the SAME fd
# is an idempotent no-op success; a call on a DIFFERENT fd while still
# raw is REFUSED with -1 (v0.7.0) rather than silently overwriting the
# saved state — overwriting would strand the first fd in raw mode with
# no way to restore it. Call `tty_cooked()` first to release the fd.
#
# v1.2.0: if the same fd was made raw by `tty_raw_nonblock`, this
# switches it back to blocking reads (VMIN = 1) and returns 0, without
# touching the saved cooked state. (No sequence before v1.2.0 could
# reach that case; every earlier one behaves exactly as it did.)
#
# An `fd` outside [0, 0x7FFFFFFF] is rejected with -1 before any syscall
# (v1.1.4) — the kernel would otherwise read its low 32 bits as a
# different descriptor. See `_tty_fd_ok`.
fn tty_raw(fd) {
    return _tty_set_mode(fd, _TTY_RAW);
}

# Enter raw mode on `fd` with reads that return at once: VMIN = 0 and
# VTIME = 0, so read(2) answers 0 immediately when no byte is waiting,
# instead of blocking for one. Everything else is `tty_raw`'s mask and
# `tty_raw`'s contract: the same single raw slot (a different fd while
# raw is refused with -1), the same saved cooked state, the same
# `tty_cooked()` restore. On the fd already raw via `tty_raw`, this
# switches it to non-blocking reads and returns 0; `tty_raw` switches
# back. Returns 0 on success, -1 on ioctl failure or an `fd` outside
# [0, 0x7FFFFFFF].
#
# v1.2.0. For poll and game loops that must not block on `read(0)`.
# thoth reached this by calling the private `_tty_apply_raw_flags` and
# patching VMIN / VTIME itself; five other AGNOS projects hand-roll the
# same termios edit without depending on darshana.
fn tty_raw_nonblock(fd) {
    return _tty_set_mode(fd, _TTY_RAW_NB);
}

# Turn echo off on `fd` for a password or passphrase prompt, keeping line
# editing: the user types a whole line, backspace works, and nothing they
# type is shown — not even the newline, so print one yourself once the
# line is read. Input already waiting on the terminal is discarded first
# (TCSETSF), so keys typed before the prompt cannot become the secret.
# `tty_cooked()` restores the terminal. Returns 0 on success, -1 on ioctl
# failure (most often: fd is not a TTY) or an `fd` outside [0, 0x7FFFFFFF].
#
# The same single slot as `tty_raw` (v1.3.0): a different fd while the
# slot is held is refused with -1, and on the fd that holds it this
# switches to echo-off from either raw mode — `tty_raw` switches back.
# The saved state is always the cooked one from before the first call.
fn tty_echo_off(fd) {
    return _tty_set_mode(fd, _TTY_NOECHO);
}

# Discard input the terminal on `fd` has received but nobody has read
# (TCFLSH, TCIFLUSH) — so keys pressed before a confirmation prompt cannot
# answer it. Output is untouched, and so is the slot: this works in any
# mode, raw or not. Returns 0 on success, -1 on ioctl failure (most
# often: fd is not a TTY) or an `fd` outside [0, 0x7FFFFFFF] (v1.3.0).
fn tty_flush_input(fd) {
    if (_tty_fd_ok(fd) == 0) { return 0 - 1; }
    if (sys_ioctl(fd, _TCFLSH, _TCIFLUSH) < 0) { return 0 - 1; }
    return 0;
}

# Restore cooked mode onto the fd `tty_raw` saved (`_tty_raw_fd`).
# Zero-arg as of v0.7.0: the previous `tty_cooked(fd)` signature
# implied a per-fd restore the single saved-state slot can't deliver
# (tty_raw(A) + tty_cooked(B) would have written A's state onto B), so
# the parameter was dropped. Idempotent: a no-op success when not raw.
#
# On TCSETS failure returns -1 and leaves `_tty_in_raw` set, so the
# caller may retry; until a restore succeeds the terminal is left in
# raw mode (state unspecified from the user's point of view).
#
# A PERMANENTLY failing restore (EBADF once the raw fd is closed, EIO
# after a hangup — measured on a pty whose master was closed) strands the
# slot: `_tty_in_raw` stays 1, so
# `tty_raw` on a DIFFERENT fd is refused for the rest of the process.
# No public reset exists, by design — every consumer's answer to a
# failed restore is to exit. Do NOT retry `tty_cooked()` after the
# original fd number has been closed and reissued: the retry would
# write the dead terminal's saved 60 bytes onto whatever now owns
# that descriptor.
fn tty_cooked() {
    if (_tty_in_raw == 0) { return 0; }
    var rc = sys_ioctl(_tty_raw_fd, TCSETS, &_tty_saved);
    if (rc < 0) { return 0 - 1; }
    _tty_in_raw = 0;
    return 0;
}

# Free the single raw slot WITHOUT restoring the terminal (v1.3.0).
#
# For the one case `tty_cooked()` cannot recover from: its TCSETS fails
# for good — the terminal hung up, the fd was closed underneath it — so
# the slot stays held and every later `tty_raw` / `tty_raw_nonblock` /
# `tty_echo_off` on any other fd is refused for the life of the process
# (architecture note 001). After `tty_forget()` the next mode call saves
# fresh state from its own fd.
#
# The terminal is left exactly as it is. Call `tty_cooked()` first, and
# `tty_forget()` only when that returned -1; on a live terminal, forgetting
# instead of restoring leaves the user's shell raw.
#
# Always returns 0. Idempotent; a no-op when nothing is held.
fn tty_forget() {
    _tty_in_raw = 0;
    return 0;
}

# Query terminal dimensions via TIOCGWINSZ. Writes rows + cols into
# the caller's out-pointers. Returns 0 on success, -1 on ioctl
# failure (most often: fd is not a TTY) or on an `fd` outside
# [0, 0x7FFFFFFF] (v1.1.4 — see `_tty_fd_ok`). On -1 the out-pointers
# are not written.
#
# ⚠ 0 does not promise a usable size. A pseudo-terminal whose size was
# never set — common under `script`, CI runners and some multiplexers
# before they resize — answers TIOCGWINSZ successfully with 0 rows and 0
# columns, so this returns 0 with both out-values 0. Callers that divide
# by, or lay out against, the size must treat a 0 dimension as unknown
# and fall back to their own default. (Four consumers each discovered
# this independently; v1.1.4 writes it down.)
#
# Out-pointer contract: `out_rows` and `out_cols` each receive an
# i64 (8 bytes) via `store64`. This is the only darshana primitive
# that writes a fixed-width value through an OUT-PARAMETER — a pointer
# whose only purpose is to receive a result. (`tio_store32` also writes
# a fixed width — 4 bytes — through a caller pointer, but that pointer
# is the termios buffer the caller is editing, not an out-param; the
# corrected wording lands in v1.0.2, which found the older "the only
# darshana primitive that writes a FIXED-WIDTH value through
# caller-supplied pointers" simply false.)
# The six `_buf` composers — tty_dec_buf (cursor.cyr) and tty_sgr_buf
# / tty_sgr_reset_buf / tty_fg_rgb_buf / tty_bg_rgb_buf /
# tty_fg_256_buf (ansi.cyr) — also write through a caller pointer, but
# a VARIABLE number of bytes at `buf + pos`, and none takes a capacity
# argument; each documents its own byte budget. Between them those are
# the surfaces where a malformed pointer corrupts caller memory.
# Callers must pass
# `&var` where `var` is a Cyrius natural — i.e., declared as
# `var rows = 0;`. Passing a pointer to a smaller slot (e.g., a single
# byte inside a struct) will overflow that slot. The values themselves fit in u16 (kernel
# struct field width) and rarely exceed ~1000, but the slot width is
# i64, not u16.
#
# struct winsize layout (Linux):
#   off 0  u16 row     # rows of cells
#   off 2  u16 col     # cols of cells
#   off 4  u16 xpix    # pixel width  (rarely populated; ignored)
#   off 6  u16 ypix    # pixel height (rarely populated; ignored)
#
# v0.3.0 — added for chakshu M2 Slice D (dynamic resize); cyim, kii and
# thoth have since adopted it.
fn tty_winsize(fd, out_rows, out_cols) {
    if (_tty_fd_ok(fd) == 0) { return 0 - 1; }       # v1.1.4 — see _tty_fd_ok
    var ws[8];
    var rc = sys_ioctl(fd, TIOCGWINSZ, &ws);
    if (rc < 0) { return 0 - 1; }
    var rows = load8(&ws + 0) | (load8(&ws + 1) << 8);
    var cols = load8(&ws + 2) | (load8(&ws + 3) << 8);
    store64(out_rows, rows);
    store64(out_cols, cols);
    return 0;
}

# Is `fd` an open TTY? Returns 1 if yes, 0 otherwise — a strict 1/0
# predicate, never a leaked errno. An `fd` outside [0, 0x7FFFFFFF] is 0
# without a syscall (v1.1.4 — see `_tty_fd_ok`). Implemented as the cheapest
# TTY-property syscall: TIOCGWINSZ succeeds only on a TTY. This agrees
# with libc isatty(3) in practice on Linux, though it is NOT the same
# mechanism — glibc's isatty(3) probes via TCGETS (tcgetattr); both
# ioctls succeed exactly on TTYs, so the verdicts match. The 8-byte
# winsize buffer is stack-allocated and discarded; this fn does not
# read its contents (see `tty_winsize` for the variant on the same
# TIOCGWINSZ path that returns the dimensions).
#
# v0.5.3 — added for anuenue M6 color-mode negotiation, which
# previously overloaded `tty_winsize` with dummy out pointers as a
# stand-in (`_isatty_compat`). Same syscall, cleaner surface.
#
# On Linux the answer is always about `fd`; `tty_isatty_is_per_fd()`
# (v1.6.0) is 1 here. On AGNOS it is not always, and that call says so.
fn tty_isatty(fd) {
    if (_tty_fd_ok(fd) == 0) { return 0; }           # v1.1.4 — see _tty_fd_ok
    var ws[8];
    var rc = sys_ioctl(fd, TIOCGWINSZ, &ws);
    if (rc < 0) { return 0; }
    return 1;
}

# Is `tty_isatty(fd)`'s answer about `fd` on this platform? Returns 1 if
# yes, 0 if it answers about something wider than the fd: a strict 1/0
# predicate. It takes no argument because the answer is a property of the
# platform, not of any fd, and it does not change during a process.
#
# Linux: always 1, with no syscall. TIOCGWINSZ is asked of `fd` itself, so
# a pipe or a file fails it. The AGNOS peer is where the answer can be 0.
#
# A consumer that decorates output (colour, icons, a grid) only for a
# terminal, and must not put escapes into `prog > file`, asks both:
# decorate when `tty_isatty_is_per_fd()` is 1 and `tty_isatty(fd)` is 1.
#
# v1.6.0 (ADR 0008) — added for darshini, which keeps its AGNOS listing
# plain until it can tell a per-fd answer from a console-wide one.
fn tty_isatty_is_per_fd() {
    return 1;
}

# Block the signals in `sigmask` on this thread and create a signalfd
# that delivers them. Returns the signalfd, or -1 on failure (caller
# should degrade gracefully — falling back to no-signal-handling is
# usually preferable to refusing to launch).
#
# A failed open leaves NO residue: if `signalfd(2)` fails after the
# block landed, the SIG_BLOCK is rolled back before returning, so the
# -1 path needs no caller cleanup. The failure return is always
# exactly -1, never a raw `-errno` (v0.9.3 — through v0.9.2 the
# `signalfd` result was returned unnormalized, so a failing call
# surfaced e.g. -24/EMFILE and left the signals blocked forever).
#
# "No residue" is exact as of v1.0.2, and the distinction matters: the
# rollback unblocks only the signals THIS call actually added to the
# thread mask (`sigmask & ~prev`), not the whole of `sigmask`. Through
# v1.0.1 it unblocked everything requested, so a failed open UNBLOCKED
# a signal the caller had already blocked — including one owned by an
# earlier, still-live darshana signalfd. That is the documented
# multi-signalfd pattern (chakshu holds an EXIT fd and a WINCH fd), and
# the consequence was that the first fd went deaf: with
# TTY_SIGMASK_EXIT the next Ctrl-C killed the process outright instead
# of waking the poll loop, so the consumer's teardown — alt-screen
# leave, cursor show, `tty_cooked()` — never ran and the user landed
# back in a raw, alt-screened shell. Reproduced under RLIMIT_NOFILE=3
# and covered by tests/darshana.tcyr.
#
# The rollback deliberately uses SIG_UNBLOCK of the added bits rather
# than SIG_SETMASK of the captured mask: `how` 0 and 1 are the only two
# values every target names explicitly. The AGNOS kernel's sigprocmask#17
# handles 0 and 1 by name and stores any other `how` verbatim; mirshi
# does name SIG_SETMASK, but the bare kernel does not. (Corrected v1.1.4:
# this used to attribute the fall-through to mirshi.)
#
# The SIG_BLOCK installed here persists on the thread until explicitly
# undone — closing the returned fd does NOT unblock the signals. Pair
# every successful call with `tty_close_signalfd(fd, sigmask)` on the
# teardown path (including the SIGINT/SIGTERM exit path) to close the
# fd and unblock the signals in `sigmask` — and make that the LAST step of
# the teardown (see `tty_close_signalfd` for why).
#
# Holding more than one at a time: give each live signalfd a DISJOINT
# mask. `tty_close_signalfd` unblocks every bit it is handed, so closing
# one of two signalfds that share a signal unblocks it for the other one
# too, and that fd goes deaf. Disjoint masks (chakshu's EXIT fd and WINCH
# fd) compose; overlapping ones do not.
#
# A non-blocking fd: call the stdlib's `fd_set_nonblocking(fd)` (cyrius
# 6.6.8+) on the returned fd. darshana needs no flag of its own for it.
#
# ⚠ The block is inherited by children. SIG_BLOCK survives fork() AND
# execve() (SFD_CLOEXEC below covers only the fd), so a pager, editor or
# shell spawned while the signalfd is live starts with these signals
# blocked: Ctrl-C and SIGTERM cannot stop it and it survives a hangup.
# Unblock `sigmask` in the child between fork and exec, or close the
# signalfd before spawning. (Measured v1.1.4: an exec'd child showed
# `SigBlk: 0000000000004003` under TTY_SIGMASK_EXIT.)
#
# `sigmask` is a single u64 representing a Linux sigset_t (bit N set
# = signal N+1 in the mask). Common values are exposed as constants:
# TTY_SIGMASK_EXIT for HUP/INT/TERM cleanup, TTY_SIGMASK_WINCH for
# resize. Callers can OR them or build custom masks.
#
# Avoids the rt_sigaction x86_64 sa_restorer trampoline trap by
# routing signals to a regular fd instead of installing synchronous
# handlers — pure syscall, no inline assembly needed.
#
# v0.3.0 — promoted from chakshu's `_tui_open_exit_signalfd` after
# chakshu became the second consumer needing the same machinery
# (Slice D adds SIGWINCH handling — same pattern, different mask).
fn tty_open_signalfd(sigmask) {
    var mask[8];
    # `store64` writes all 8 bytes of `mask`, so no pre-zero loop is
    # needed (one shipped here through v0.9.2 and was pure dead store).
    store64(&mask, sigmask);
    # Capture the mask in force on entry (v1.0.2) so the failure path
    # can put back exactly what it changed. `prev` is pre-zeroed: on a
    # kernel that left oldset untouched we would rather compute an
    # empty prior mask (and unblock everything we asked for, the old
    # v1.0.1 behaviour) than read stack garbage.
    var prev[8];
    store64(&prev, 0);
    var rc = sys_sigprocmask(SIG_BLOCK, &mask, &prev);
    if (rc < 0) { return 0 - 1; }
    # signalfd(fd=-1, mask, SFD_CLOEXEC) → new fd. CLOEXEC so the
    # signalfd does not leak across an execve — a consumer that takes
    # over the screen and later spawns a child (editor shelling out,
    # pager, $SHELL) must not hand this fd to it. SFD_CLOEXEC is the
    # stdlib SfdFlag enum value (0x80000); same CLOEXEC discipline the
    # stdlib's epoll wrapper follows. It covers the fd only — the signal
    # mask is inherited regardless (see the docstring).
    var sfd = sys_signalfd(0 - 1, &mask, SFD_CLOEXEC);
    if (sfd < 0) {
        # Roll the block back: the caller gets no fd,
        # so it has nothing to hand `tty_close_signalfd` and would
        # otherwise run with these signals blocked for the whole
        # process lifetime. This also normalizes the raw `-errno` the
        # bare syscall passthrough surfaces into the documented -1.
        #
        # Unblock ONLY what this call added (`sigmask & ~prev`), so a
        # signal the caller had already blocked — e.g. one an earlier
        # live signalfd owns — is left blocked. See the docstring.
        var added[8];
        store64(&added, sigmask & ~load64(&prev));
        sys_sigprocmask(SIG_UNBLOCK, &added, 0);
        return 0 - 1;
    }
    return sfd;
}

# Teardown counterpart to `tty_open_signalfd`: close `fd` and UNblock
# the signals in `sigmask`. Closing the fd alone is not enough — the
# SIG_BLOCK would otherwise persist and the consumer's signals stay
# silently blocked after its UI exits (e.g. a parent that resumes once
# the TUI returns). Pass the SAME `sigmask` that was passed to
# `tty_open_signalfd`.
#
# This UNBLOCKS every bit of `sigmask`; it does not RESTORE a saved
# mask. `tty_open_signalfd` captures the prior mask, but only to roll
# back its own failure — nothing keeps it, so close cannot put it back.
# A signal the caller had ALREADY blocked before the open is therefore
# left UNBLOCKED after the matching close. That is deliberate: a
# save-and-SIG_SETMASK restore would let the first of two closes stomp
# the second signalfd's blocks. The price is that live signalfds must
# have DISJOINT masks — closing one of two that share a signal unblocks
# it for both (see `tty_open_signalfd`). (Corrected v1.1.4: this used to
# say the open passes oldset = NULL, false since v1.0.2, and that the
# scheme "composes" without the disjointness condition.)
#
# ⚠ Make this the LAST step of a teardown — after `tty_cooked()` and
# the screen restore. Closing the fd does not discard a signal that
# arrived but was never read: it stays pending, and this unblock
# delivers it at once with its default action. For TTY_SIGMASK_EXIT
# that is SIGINT / SIGTERM / SIGHUP, whose default terminates the
# process — so a teardown that closes the signalfd first can be killed
# halfway, leaving the terminal raw on the alt screen. Done last, the
# same delivery is harmless: the terminal is already restored.
# (tests/darshana.tcyr proves the pending delivery, v1.1.4.)
#
# The fd is closed best-effort, except that an `fd` outside
# [0, 0x7FFFFFFF] is not closed at all (v1.1.4 — see `_tty_fd_ok`); the
# unblock runs either way. The return reflects the unblock — 0 on
# success, exactly -1 if sigprocmask fails, never a raw `-errno`.
# v0.7.0 — added so the open primitive isn't frozen at v1.0 without its
# teardown counterpart (chakshu's signalfd-driven exit is the first
# consumer).
#
# The -1 normalization landed in v1.0.2. v0.9.3 normalized
# `tty_open_signalfd`'s sentinel and missed its teardown twin, which
# went on returning `sys_sigprocmask`'s bare syscall result — so a
# failure surfaced as e.g. -22/EINVAL where this docstring promised -1,
# and the AGNOS peer (whose kernel already normalizes) disagreed with
# the Linux one on a contract both claimed to share. Latent rather than
# live: `rt_sigprocmask(SIG_UNBLOCK, <valid stack ptr>, NULL, 8)` has no
# reachable failure mode here. Fixing the code to match the frozen
# docstring is a patch under ADR 0003, which names exactly this case.
fn tty_close_signalfd(fd, sigmask) {
    # v1.1.4: an fd outside [0, 0x7FFFFFFF] is not closed — the kernel would
    # read its low 32 bits and close a DIFFERENT, live descriptor. The
    # unblock still runs, so the mask half of the contract is unchanged.
    if (_tty_fd_ok(fd) == 1) { file_close(fd); }
    var mask[8];
    store64(&mask, sigmask);
    var rc = sys_sigprocmask(SIG_UNBLOCK, &mask, 0);
    if (rc < 0) { return 0 - 1; }
    return 0;
}

# Read the next signal from a signalfd opened by `tty_open_signalfd`,
# consuming it. Returns the signal number (> 0); 0 if nothing is pending
# on a NON-blocking fd (see `tty_open_signalfd` for `fd_set_nonblocking`);
# or -1 on any other failure, including an `fd` outside [0, 0x7FFFFFFF]
# and a descriptor that is not a signalfd. On a blocking fd it waits for
# a signal, like read(2). Never a raw `-errno`.
#
# v1.2.0. Three consumers (chakshu, cyim, anuenue) each read the kernel's
# 128-byte `struct signalfd_siginfo` by hand to learn which signal woke
# them; the signal number is its first field, a u32 at offset 0. The
# number is the platform's own: SIGINT 2, SIGTERM 15, SIGWINCH 28 on both
# Linux arches and on AGNOS.
fn tty_read_signal(fd) {
    if (_tty_fd_ok(fd) == 0) { return 0 - 1; }
    var info[128];
    var n = sys_read(fd, &info, 128);
    if (n == 128) { return tio_load32(&info, 0); }
    if (n == 0 - EAGAIN) { return 0; }         # non-blocking, nothing pending
    return 0 - 1;
}

#endif

#ifdef CYRIUS_TARGET_AGNOS

# AGNOS terminal window size. agnos has no `ioctl(TIOCGWINSZ)` (its frozen
# syscall surface has no ioctl), so the kernel instead exposes the live
# framebuffer console grid directly via syscall #60 (`winsize`). It returns the
# two counts packed into one i64 — bits 16-31 = cols, bits 0-15 = rows — or
# -1 if the framebuffer isn't up. This is the agnos peer of the Linux
# `tty_winsize` above and preserves its contract EXACTLY: writes rows + cols
# through the caller's out-pointers (each an i64 via `store64`), returns 0 on
# success / -1 on failure. So consumers (kii / chakshu) call one `tty_winsize`
# and the platform branch is invisible to them — kii drops its
# `#ifndef CYRIUS_TARGET_AGNOS` gate and gets the real console grid on agnos,
# falling back to its 80×24 default only when this returns -1.
#
# `fd` is accepted for signature parity with the Linux variant but ignored: the
# console grid is a global property of the framebuffer, not a per-fd attribute.
#
# The call is the agnos stdlib's `sys_winsize()`, which owns the syscall
# number: this arm carries no copy of the kernel's ABI to keep in step.

# AGNOS peer of `tty_winsize`. Writes rows + cols through the caller's
# out-pointers (each an i64 via `store64`) and returns 0 on success, -1 if
# the framebuffer console is not up — the Linux contract exactly. `fd` is
# accepted for signature parity and ignored: the console grid is a global
# framebuffer property, not a per-fd attribute. See the long-form rationale
# in the block above.
fn tty_winsize(fd, out_rows, out_cols) {
    var packed = sys_winsize();
    if (packed < 0) { return 0 - 1; }
    return _agnos_winsize_unpack(packed, out_rows, out_cols);
}

# Decode winsize#60's packed reply — bits 0-15 rows, bits 16-31 cols —
# through the caller's out-pointers. Always returns 0.
#
# Private (v1.2.0), and pure, so tests/agnos.tcyr can exercise the AGNOS
# decode on a Linux host, where the syscall itself is uncallable (agnos 60
# is Linux `exit`). Through v1.1.4 the decode was inline in tty_winsize and
# had compile coverage only: swapping rows and cols survived every gate.
fn _agnos_winsize_unpack(packed, out_rows, out_cols) {
    store64(out_rows, packed & 0xFFFF);
    store64(out_cols, (packed >> 16) & 0xFFFF);
    return 0;
}

# The console's line mode and the fd-kind query (v1.5.0, ADR 0007). agnos
# 1.57.13 added two calls, which the stdlib wraps from cyrius 6.7.11:
# `console_mode#110(set, clear)` turns the console's echo off and on
# (`CM_NOECHO`) and discards typeahead (`CM_FLUSH`), answering the flags from
# before the call or -1; `fd_kind#111(fd)` says what an fd is. Before 1.57.13
# neither exists and both answer -1, so every arm below first asks whether
# this kernel has them, once, and on a kernel that does not keeps the answer
# it gave through 1.4.0.
#
# What counts as a terminal: the console (`FDK_CONSOLE`), and a `#97` channel
# endpoint (`FDK_CHAN`), which is how a terminal emulator such as puka hands
# its child stdio. A file, a pipe (agnsh pipelines use pipe#25), a directory,
# a socket or an event fd is not. Only the console's line mode can be set
# from here: a terminal emulator runs its own line discipline, and agnos gives
# darshana no call to reach it.

# Whether this kernel has console_mode#110 and fd_kind#111: 0 not asked yet,
# 1 yes, -1 no. Asked once, with console_mode's query (0, 0), which changes
# nothing. Both calls arrived in agnos 1.57.13, and a kernel cannot lose one
# mid-process. Asking once also keeps a process quiet under an emulator that
# lacks them: mirshi 1.11.3 prints a line for every unknown call.
var _agnos_tty_calls = 0;

# 1 if this kernel has the console-mode and fd-kind calls, 0 if not.
# Private (v1.5.0). `tty_isatty_is_per_fd` (v1.6.0) is its public answer.
fn _agnos_has_tty_calls() {
    if (_agnos_tty_calls == 0) {
        if (sys_console_mode(0, 0) >= 0) { _agnos_tty_calls = 1; }
        else { _agnos_tty_calls = 0 - 1; }
    }
    if (_agnos_tty_calls == 1) { return 1; }
    return 0;
}

# 1 if `fd` is the agnos console on a kernel that can say so, 0 otherwise,
# including an `fd` outside [0, 0x7FFFFFFF]. Private (v1.5.0).
fn _agnos_console_fd(fd) {
    if (fd < 0 || fd > 0x7FFFFFFF) { return 0; }
    if (_agnos_has_tty_calls() == 0) { return 0; }
    if (sys_fd_kind(fd) == FDK_CONSOLE) { return 1; }
    return 0;
}

# AGNOS peer of `tty_isatty`. Returns 1 if `fd` is a terminal, 0 otherwise — a
# strict 1/0 predicate. An `fd` outside [0, 0x7FFFFFFF] is 0 without a syscall.
#
# From v1.5.0, on agnos 1.57.13 and later, the answer is about `fd`: 1 for
# the console and for a terminal emulator's channel (see the block above), 0
# for a file, a pipe, a closed fd and everything else, so `prog > file` and
# `prog | other` no longer receive escapes.
#
# ⚠ On an older kernel, and under an emulator without fd_kind#111, the
# answer is still about the CONSOLE, as through 1.4.0: 1 when the
# framebuffer console is up (winsize#60 succeeds), whatever `fd` is.
# `tty_isatty_is_per_fd()` (v1.6.0) says which of the two this kernel gives.
fn tty_isatty(fd) {
    if (fd < 0 || fd > 0x7FFFFFFF) { return 0; }
    if (_agnos_has_tty_calls() == 1) {
        var kind = sys_fd_kind(fd);
        if (kind == FDK_CONSOLE || kind == FDK_CHAN) { return 1; }
        return 0;
    }
    if (sys_winsize() < 0) { return 0; }
    return 1;
}

# AGNOS peer of `tty_isatty_is_per_fd`. Returns 1 if `tty_isatty(fd)` on
# this kernel answers about `fd`, 0 if it answers about the console: a
# strict 1/0 predicate.
#
# 1 on agnos 1.57.13 and later, which have fd_kind#111. 0 on an older
# kernel and under an emulator without the call (mirshi 1.11.3), where
# `tty_isatty` is 1 whenever the console is up, for a pipe or a file too.
# On a 0, a 1 from `tty_isatty` does not show that `fd` is a terminal, so
# do not write escapes on it alone.
#
# It reads the same once-per-process probe as `tty_isatty` (console_mode#110's
# query, which changes nothing) and shares its cached answer, so asking both
# costs at most one probe, and under mirshi 1.11.3 one
# `mirshi: ENOSYS agnos#110 -> -1` line.
fn tty_isatty_is_per_fd() {
    return _agnos_has_tty_calls();
}

# AGNOS raw-mode enter. agnos has no termios (no TCGETS/TCSETS), so there is no
# canonical/raw toggle to flip — the kernel console runs its own line discipline.
# Returns -1, at parity with the Linux "couldn't enter raw" failure, so consumers
# take their designed fallback (thoth/chakshu drop to their line REPL).
#
# -1 is the answer BY DESIGN, not a stopgap. Raw key input does exist on agnos —
# kbscan#42 delivers Set-1 scancodes, and chakshu and cyim decode them
# themselves — but decoding input is outside darshana's charter (owner ruling,
# 2026-10-12; roadmap.md § Out of scope). A consumer wanting raw keys on agnos
# reads kbscan itself. Only a kernel-side raw-mode switch on the agnos console
# would make this a real peer, as a termios-shaped wrapper rather than a
# decoder. (console_mode#110 is not one: it hides the cooked line, and reads
# still return whole lines.) A silent success here would strand the caller
# waiting on per-key input that never arrives.
fn tty_raw(fd) {
    return 0 - 1;
}

# AGNOS peer of `tty_raw_nonblock`. agnos has no termios, so there is no
# VMIN to set: returns -1, exactly like the AGNOS `tty_raw` and for the
# same reason (see its docstring).
fn tty_raw_nonblock(fd) {
    return 0 - 1;
}

# The single save slot, as on Linux. On this arm only `tty_echo_off` can
# take it, since raw mode is always -1. `_tty_raw_fd` is the console fd it
# was taken on; `_agnos_saved_mode` is the console's CM_NOECHO bit from
# before, which `tty_cooked()` puts back (v1.5.0).
var _tty_in_raw = 0;
var _tty_raw_fd = 0;
var _agnos_saved_mode = 0;

# AGNOS peer of `tty_echo_off`. Returns 0 on success, -1 otherwise.
#
# From v1.5.0, on agnos 1.57.13 and later: when `fd` is the console, the
# console's echo goes off and its typeahead is discarded in one call
# (console_mode#110 with CM_NOECHO | CM_FLUSH, agnos's TCSETSF). Reads
# still return whole edited lines, nothing typed is shown, not even the
# newline, so print one yourself. `tty_cooked()` restores the echo state
# from before. The mode is the console's: anything that reads the console
# meanwhile, a child included, reads hidden. agnos clears it when this
# process dies, however it dies, so a crash cannot leave the console dark.
#
# The same single slot as Linux: a different fd while the slot is held is
# refused with -1, even another fd on the console, and the fd that holds
# it gets a no-op 0.
#
# -1 when `fd` is not the console, including a terminal emulator's channel
# (the emulator runs its own echo, and agnos gives darshana no call to
# reach it), when the call fails, and on a kernel older than 1.57.13,
# where nothing can turn the echo off. Through 1.4.0 this was -1 always.
fn tty_echo_off(fd) {
    if (_agnos_console_fd(fd) == 0) { return 0 - 1; }
    if (_tty_in_raw == 1) {
        if (fd != _tty_raw_fd) { return 0 - 1; }
        return 0;                                # already off: the only mode here
    }
    var prev = sys_console_mode(CM_NOECHO | CM_FLUSH, 0);
    if (prev < 0) { return 0 - 1; }
    _agnos_saved_mode = prev & CM_NOECHO;
    _tty_raw_fd = fd;
    _tty_in_raw = 1;
    return 0;
}

# AGNOS peer of `tty_flush_input`: discard the console's typeahead and any
# partly read line (console_mode#110, CM_FLUSH). Returns 0 on success, -1
# when `fd` is not the console, when the call fails, and on a kernel older
# than 1.57.13 (v1.5.0; through 1.4.0 this was -1 always). The echo mode
# and the slot are untouched.
fn tty_flush_input(fd) {
    if (_agnos_console_fd(fd) == 0) { return 0 - 1; }
    if (sys_console_mode(CM_FLUSH, 0) < 0) { return 0 - 1; }
    return 0;
}

# AGNOS cooked-mode restore. Returns 0, or -1 if the restore call fails.
#
# A no-op 0 when the slot is free: raw mode is never entered on this arm.
# When `tty_echo_off` holds it (v1.5.0), this puts the console's echo back
# as it was before (console_mode#110 clearing CM_NOECHO, unless echo was
# already off then) and frees the slot. On failure the slot stays held, so
# the caller may retry, as on Linux.
fn tty_cooked() {
    if (_tty_in_raw == 0) { return 0; }
    if (_agnos_saved_mode == 0) {
        if (sys_console_mode(0, CM_NOECHO) < 0) { return 0 - 1; }
    }
    _tty_in_raw = 0;
    return 0;
}

# AGNOS peer of `tty_forget`: free the slot WITHOUT restoring the console,
# and issue no call. On this arm the console clears its echo mode when the
# process dies, so a stranded slot costs less than on Linux; the contract is
# kept for parity. Always returns 0. Idempotent.
fn tty_forget() {
    _tty_in_raw = 0;
    return 0;
}

# AGNOS signal masks for `tty_open_signalfd`. agnos/mirshi represent a signal
# SET as `1 << sig` (bit N = signal N) — NOT Linux's `1 << (sig-1)` sigset_t
# layout — so these values DIFFER from the Linux branch above by one bit
# position per signal. mirshi's sigprocmask#17 / signalfd#18 store the mask
# verbatim and its delivery walk (`_sig_lowest`) tests bit `sig` directly
# (mirshi children.cyr: "the per-child … mask (agnos `1<<sig`)"). Copying the
# Linux 0x4003 / 0x08000000 here would silently watch the wrong signals.
#   TTY_SIGMASK_EXIT  = SIGHUP(1) | SIGINT(2) | SIGTERM(15) → bits 1,2,15 → 0x8006
#   TTY_SIGMASK_WINCH = SIGWINCH(28)                        → bit  28     → 0x10000000
#   TTY_SIGMASK_PIPE  = SIGPIPE(13)                         → bit  13     → 0x2000
#
# SIGWINCH: from agnos 1.57.13 the kernel posts SIGWINCH (28) to a process
# watching bit 28 through a signalfd when the console grid really changes,
# which is this mask (agnos's own tty-smoke T7 proves the post; darshana has
# not run its WINCH signalfd against it). Before 1.57.13 nothing raises it,
# and mirshi does not, so a WINCH signalfd opens fine and never fires there.
# Poll `tty_winsize` where that matters.
#
# ⚠ agnos has no SIGPIPE: a write with no reader left returns its partial
# count or -1 instead (the stdlib's agnos `sys_write`). TTY_SIGMASK_PIPE is
# here so a consumer stays platform-blind; its signalfd never fires.
var TTY_SIGMASK_EXIT  = 0x8006;
var TTY_SIGMASK_WINCH = 0x10000000;
var TTY_SIGMASK_PIPE  = 0x2000;

# The signalfd path calls the agnos stdlib's `sys_sigprocmask` (#17) and
# `sys_signalfd` (#18), which own the syscall numbers — the same wrapper
# names the Linux arm calls, each resolving to its own target's syscall —
# and the stdlib's `SIG_BLOCK` / `SIG_UNBLOCK` / `SFD_CLOEXEC`, which have
# the same values on agnos as on Linux.
#
# SFD_CLOEXEC is passed for parity with the Linux peer's CLOEXEC
# discipline. mirshi's MVP signalfd is an opaque supervisor-side fd (no execve
# fd-inheritance across the ptrace boundary) and is always non-blocking, so it
# stores `flags` but does not act on them.

# AGNOS peer of `tty_open_signalfd`. Blocks the signals in `sigmask` on this
# thread (sigprocmask#17, SIG_BLOCK) then creates an emulated signalfd
# (signalfd#18, fd=-1 → allocate a new slot). Returns the emulated fd (>= 0) or
# -1 on failure. Preserves the Linux peer's contract EXACTLY so consumers call
# one `tty_open_signalfd` and the platform branch is invisible to them.
#
# mirshi's signalfd is edge-triggered + NON-BLOCKING: the caller polls it via
# epoll_wait#21 / read#5 rather than blocking on the fd — the same poll-driven
# usage the Linux peer's consumers already follow. `sigmask` is an agnos
# `1<<sig` set (see TTY_SIGMASK_* above), an 8-byte word like the Linux path.
#
# ⚠ Under mirshi (the agnos-on-Linux supervisor) this fd receives NOTHING
# today: mirshi delivers only signals that are pending AND unblocked through
# a signalfd, and this function — correctly, as on Linux and on the agnos
# kernel — blocks them first. A signal from the host (a terminal Ctrl-C, a
# host kill) also bypasses mirshi's agnos signal model and arrives as a real
# Linux signal with its default action. Both are filed in mirshi's roadmap
# (2026-10-12, confirmed by run); on the agnos kernel itself the fd works.
fn tty_open_signalfd(sigmask) {
    var mask[8];
    store64(&mask, sigmask);
    # Capture the entry mask (v1.0.2) — mirshi's sigprocmask#17 honours
    # a non-NULL oldset_ptr (`if (arg3 != 0) { store64(arg3, old_mask); }`).
    # Pre-zeroed for the same reason as the Linux peer.
    var prev[8];
    store64(&prev, 0);
    var rc = sys_sigprocmask(SIG_BLOCK, &mask, &prev);
    if (rc < 0) { return 0 - 1; }
    # signalfd(fd=-1, mask, SFD_CLOEXEC) → new emulated fd.
    var sfd = sys_signalfd(0 - 1, &mask, SFD_CLOEXEC);
    if (sfd < 0) {
        # Roll the block back, exactly as the Linux
        # peer does. mirshi already normalizes its failures to -1, so
        # only the rollback is substantive here; the shape is kept
        # identical so the two peers stay readable side by side.
        #
        # Unblock only the bits this call added, matching the Linux
        # peer (v1.0.2). Both the agnos kernel and mirshi name how 0 and
        # 1, so this needs no SIG_SETMASK — which the bare kernel would
        # only honour as an unnamed store-verbatim fall-through.
        var added[8];
        store64(&added, sigmask & ~load64(&prev));
        sys_sigprocmask(SIG_UNBLOCK, &added, 0);
        return 0 - 1;
    }
    return sfd;
}

# AGNOS peer of `tty_close_signalfd`: close `fd` and UNblock the signals in
# `sigmask` (sigprocmask#17, SIG_UNBLOCK). Closing the fd alone is not enough
# — the SIG_BLOCK would persist and the consumer's signals stay silently
# blocked after its UI exits. Like the Linux peer this UNBLOCKS rather than
# restoring a captured mask, needs DISJOINT masks across live signalfds, and
# belongs LAST in a teardown; see that docstring for why.
# Pass the SAME `sigmask` given to `tty_open_signalfd`. The fd is closed
# best-effort, except that a negative `fd` is never passed to close (v1.1.4):
# the stdlib's agnos `sys_close` treats any fd with bit 0x40000000 set as a
# tagged socket, and -1 has it, so `close(-1)` freed socket slot 7 — a live
# connection, if one was there. The unblock runs either way. The return
# reflects the unblock — 0 on success, exactly -1 if sigprocmask fails.
# Mirrors the Linux peer above.
#
# ⚠ Under mirshi a closed signalfd's slot is not freed (mirshi's documented
# v1.6.0 slot-leak limit; 8 slots per process), so after 8 open/close cycles
# every further `tty_open_signalfd` returns -1. The bare agnos kernel frees it.
#
# mirshi already normalizes its own failures to -1, so the explicit clamp
# below is redundant TODAY. It is written anyway (v1.0.2) so the two peers
# are structurally identical: the Linux twin needed the clamp, and a peer
# that merely happens to agree because its kernel is well-behaved is one
# kernel change away from silently diverging on a frozen contract.
fn tty_close_signalfd(fd, sigmask) {
    if (fd >= 0) { file_close(fd); }      # v1.1.4 — see the docstring
    var mask[8];
    store64(&mask, sigmask);
    var rc = sys_sigprocmask(SIG_UNBLOCK, &mask, 0);
    if (rc < 0) { return 0 - 1; }
    return 0;
}

# AGNOS peer of `tty_read_signal`: the next pending signal's number (> 0),
# consuming it; 0 if nothing is pending; -1 on failure or a negative `fd`.
# An agnos signalfd is always non-blocking, so this never waits.
#
# The kernel's `vfs_read_signalfd` answers a 4-byte signal number and 0
# when nothing is pending; mirshi answers an 8-byte one, and -1 when
# nothing is pending (filed in mirshi's roadmap, 2026-10-12). Reading the
# low 32 bits of a zeroed 8-byte buffer is right for both records. Under
# mirshi an empty read therefore returns -1, not 0 — and mirshi never
# delivers a blocked signal through a signalfd at all, so the call cannot
# yet see anything there.
fn tty_read_signal(fd) {
    if (fd < 0) { return 0 - 1; }
    var rec[8];
    store64(&rec, 0);
    var n = sys_read_nb(fd, &rec, 8);            # -2 = WOULD_BLOCK: nothing yet
    if (n > 0) { return tio_load32(&rec, 0); }
    if (n == 0 || n == 0 - 2) { return 0; }
    return 0 - 1;
}

#endif

# ---- platform-independent helpers over the peers above ---------------

# `tty_winsize`, but never 0 x 0: writes the terminal's rows and columns
# through the caller's out-pointers (each an i64 via `store64`), or the
# caller's `def_rows` / `def_cols` when the query fails OR answers a zero
# dimension. Always returns 0 — the out-pointers always receive a usable
# size, which is the point of the call.
#
# v1.2.0. A pty whose size was never set answers TIOCGWINSZ successfully
# with 0 x 0 (see `tty_winsize`), and four consumers each wrote this guard
# themselves (chakshu, cyim, kii, bannermanor). The defaults are the
# caller's because the consumers disagree on them (24x80 vs 80x24); any
# clamp — cyim's minimum 2x20, bannermanor's 4096 cap — stays in the
# consumer too. Both dimensions come from the same source: a 0 in either
# means the size is unknown, so both defaults are written.
fn tty_winsize_or(fd, out_rows, out_cols, def_rows, def_cols) {
    var r = 0;
    var c = 0;
    if (tty_winsize(fd, &r, &c) == 0) {
        if (r > 0 && c > 0) {
            store64(out_rows, r);
            store64(out_cols, c);
            return 0;
        }
    }
    store64(out_rows, def_rows);
    store64(out_cols, def_cols);
    return 0;
}
